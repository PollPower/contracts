// Living Dividend v3 — user-initiated dividend claims through a ledger 9
// cross-contract call into EBT.
//
// Design: docs/design/living-dividend-v3-design.md (branch wi16-ledger9).
//
// - No tokens ever sit in this contract. EBT keeps the dividend slice of every
//   settle as a budget (_dividendAccrued); a member's claim calls
//   EBT.mintDividend, which mints unshielded EBT straight to the member's
//   payout address in the same transaction and never mints past the budget.
//   EBT never calls back into LD.
// - Accrual is read from EBT (sync) before every membership change, so there
//   is no keeper and no bumpOnMint (v2's LD-H-3 is gone structurally).
// - Members prove a Jubjub key with an in-circuit Schnorr signature over
//   memberMessage(self, action, id, argsDigest, nonce); the per-member nonce
//   stops replay. The council is Multisig v8 via isApproved (cross-contract),
//   with a local consumed-action set. No authorization witness exists
//   (WI16-C-1); the only witness is the checked division helper.
// - Garrett's choices (2026-11-24):
//   (a) dividend accrued while no member is live stays unminted in EBT's
//       budget (_heldWhileEmpty records how much);
//   (b) history goes to ledger 9 contract events (Misc); maps hold only state
//       and replay protection;
//   (c) payout-address changes are signed by the member and take effect after
//       PAYOUT_CHANGE_DELAY (72 h); the member or the council can cancel.
// - Unshielded dividend payouts are a deliberate choice for this phase.

pragma language_version >= 0.28;

import CompactStandardLibrary;

contract Council {
  circuit isApproved(actionHash: Bytes<32>): Boolean;
}

contract EbtDividend {
  circuit dividendAccrued(): Uint<128>;
  circuit mintDividend(member: UserAddress, amount: Uint<128>): [];
}

// --- constants ----------------------------------------------------------------
pure circuit SCALE(): Uint<128> { return 1000000000000000000 as Uint<128>; }   // 1e18
pure circuit INACTIVITY_THRESHOLD(): Uint<64> { return 15552000 as Uint<64>; }  // 180 days
pure circuit PRUNE_GRACE_PERIOD(): Uint<64> { return 2592000 as Uint<64>; }     // 30 days
pure circuit PAYOUT_CHANGE_DELAY(): Uint<64> { return 259200 as Uint<64>; }     // 72 hours
// A timestamp that starts a delay must be within this window of block time,
// so it cannot be backdated to shorten the delay.
pure circuit FRESHNESS(): Uint<64> { return 3600 as Uint<64>; }

// --- types --------------------------------------------------------------------
struct Member {
  pk:           JubjubPoint,
  payout:       UserAddress,
  checkpoint:   Uint<128>,   // _accPerShare when last paid (or registered)
  nonce:        Uint<64>,    // bumps on every member-signed action
  lastSeen:     Uint<64>,
  registeredAt: Uint<64>,
  isLive:       Boolean,
}

struct PendingPayout {
  payout:      UserAddress,
  effectiveAt: Uint<64>,
}

struct DivResult {
  quotient:  Uint<128>,
  remainder: Uint<128>,
}

// --- ledger -------------------------------------------------------------------
export sealed ledger _ebt: EbtDividend;
export sealed ledger _council: Council;

export ledger _members: Map<Bytes<32>, Member>;        // key: memberId(pk)
export ledger _accPerShare: Uint<128>;                 // scaled by 1e18
export ledger _lastSyncedAccrued: Uint<128>;           // EBT total already distributed
export ledger _heldWhileEmpty: Uint<128>;              // (a) accrued with no live member
export ledger _live: Uint<64>;
export ledger _totalClaimed: Uint<128>;

export ledger _seenKycJobHashes: Set<Bytes<32>>;
export ledger _pendingPrunes: Map<Bytes<32>, Uint<64>>;          // proposal time
export ledger _pendingPayouts: Map<Bytes<32>, PendingPayout>;
export ledger _consumedActions: Set<Bytes<32>>;                  // council replay

// The circuit checks n == q*d + r with 0 <= r < d, so a lying witness fails.
witness witness_divmod(numerator: Field, divisor: Field): DivResult;

constructor(ebt: EbtDividend, council: Council) {
  _ebt = disclose(ebt);
  _council = disclose(council);
}

// --- exported pure helpers (the apps call these from the compiled contract) ---

export pure circuit memberId(pk: JubjubPoint): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>([
    pad(32, "pp:ld:v3:memberId"), jubjubPointX(pk) as Bytes<32>, jubjubPointY(pk) as Bytes<32>,
  ]);
}

// What a member signs (Jubjub Schnorr, one Field).
export pure circuit memberMessage(
  self: Bytes<32>, action: Bytes<32>, id: Bytes<32>, argsDigest: Bytes<32>, nonce: Uint<64>,
): Field {
  return transientHash<Vector<6, Bytes<32>>>([
    pad(32, "pp:ld:v3:member"), self, action, id, argsDigest, (nonce as Field) as Bytes<32>,
  ]);
}

export pure circuit timeDigest(t: Uint<64>): Bytes<32> {
  return (t as Field) as Bytes<32>;
}

export pure circuit payoutDigest(newPayout: UserAddress, t: Uint<64>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([newPayout.bytes, (t as Field) as Bytes<32>]);
}

// Council action hashes (Multisig v8 approves these).
export pure circuit registerActionHash(
  self: Bytes<32>, pk: JubjubPoint, payout: UserAddress, kycHash: Bytes<32>, currentTime: Uint<64>,
): Bytes<32> {
  return persistentHash<Vector<7, Bytes<32>>>([
    pad(32, "pp:ld:v3:register"), self, jubjubPointX(pk) as Bytes<32>, jubjubPointY(pk) as Bytes<32>,
    payout.bytes, kycHash, (currentTime as Field) as Bytes<32>,
  ]);
}

export pure circuit unregisterActionHash(self: Bytes<32>, id: Bytes<32>, currentTime: Uint<64>): Bytes<32> {
  return persistentHash<Vector<4, Bytes<32>>>([
    pad(32, "pp:ld:v3:unregister"), self, id, (currentTime as Field) as Bytes<32>,
  ]);
}

export pure circuit cancelPayoutActionHash(self: Bytes<32>, id: Bytes<32>, currentTime: Uint<64>): Bytes<32> {
  return persistentHash<Vector<4, Bytes<32>>>([
    pad(32, "pp:ld:v3:cancelPayout"), self, id, (currentTime as Field) as Bytes<32>,
  ]);
}

// --- internal helpers ---------------------------------------------------------------

pure circuit checkedDivide(numeratorF: Field, divisorF: Field, r: DivResult): Uint<128> {
  const qF = r.quotient as Field;
  const remF = r.remainder as Field;
  assert(numeratorF == qF * divisorF + remF, "checkedDivide: equation fails");
  const _range = (divisorF - remF - (1 as Field)) as Uint<128>;   // fails unless r < d
  return r.quotient;
}

circuit notFuture(t: Uint<64>): [] {
  assert(disclose(blockTimeGte(disclose(t))), "Timestamp in the future");
}

circuit fresh(t: Uint<64>): [] {
  notFuture(t);
  assert(disclose(blockTimeLt(disclose((t + FRESHNESS()) as Uint<64>))), "Stale timestamp");
}

circuit requireCouncil(actionHash: Bytes<32>): [] {
  const h = disclose(actionHash);
  assert(!_consumedActions.member(h), "Action already executed");
  assert(_council.isApproved(h), "Council has not approved");
  _consumedActions.insert(h);
}

circuit liveMember(id: Bytes<32>): Member {
  const k = disclose(id);
  assert(_members.member(k), "Not a live member");
  const m = _members.lookup(k);
  assert(m.isLive, "Not a live member");
  return m;
}

circuit checkMemberSig(m: Member, id: Bytes<32>, action: Bytes<32>, argsDigest: Bytes<32>,
                       sig: JubjubSchnorrSignature): [] {
  const msg: Vector<1, Field> = [memberMessage(kernel.self().bytes, action, disclose(id),
                                               disclose(argsDigest), m.nonce)];
  assert(jubjubSchnorrVerify<1>(msg, disclose(sig), m.pk), "Bad member signature");
}

circuit later(a: Uint<64>, b: Uint<64>): Uint<64> {
  return a > b ? a : b;
}

// Pull EBT's accrued total and spread what is new over the live members.
// (a): with no live member it is recorded in _heldWhileEmpty and stays
// unminted in EBT's budget; nobody receives it later.
circuit sync(): [] {
  const total = _ebt.dividendAccrued();
  const delta = (total - _lastSyncedAccrued) as Uint<128>;   // EBT's total only grows
  if (delta > 0 as Uint<128>) {
    if (_live == 0 as Uint<64>) {
      _heldWhileEmpty = disclose((_heldWhileEmpty + delta) as Uint<128>);
    } else {
      const n = (delta as Field) * (SCALE() as Field);
      const d = _live as Field;
      const q = checkedDivide(n, d, witness_divmod(n, d));
      _accPerShare = disclose((_accPerShare + q) as Uint<128>);
    }
    _lastSyncedAccrued = disclose(total);
  }
}

circuit b8(x: Bytes<32>): Vector<32, Uint<8>> {
  return x as Vector<32, Uint<8>>;
}

// (b) history: a ledger 9 Misc event, payload = four 32-byte words + zeros.
circuit logEvent(name: Bytes<32>, a: Bytes<32>, b: Bytes<32>, c: Bytes<32>, d: Bytes<32>): [] {
  const z = pad(32, "");
  const flat: Vector<256, Uint<8>> = [...b8(a), ...b8(b), ...b8(c), ...b8(d), ...b8(z), ...b8(z), ...b8(z), ...b8(z)];
  emit(Misc { name: disclose(name), payload: disclose(flat) as Bytes<256> });
}

circuit u(x: Uint<128>): Bytes<32> {
  return (x as Field) as Bytes<32>;
}

// --- council-gated membership -------------------------------------------------------

export circuit register(pk: JubjubPoint, payout: UserAddress, kycHash: Bytes<32>, currentTime: Uint<64>): [] {
  notFuture(currentTime);
  requireCouncil(registerActionHash(kernel.self().bytes, disclose(pk), disclose(payout),
                                    disclose(kycHash), disclose(currentTime)));
  const id = disclose(memberId(disclose(pk)));
  assert(!_members.member(id) || !_members.lookup(id).isLive, "Already registered");
  assert(!_seenKycJobHashes.member(disclose(kycHash)), "KYC job already used");

  sync();   // the new member shares nothing that accrued before now
  // Keep the nonce across re-registration so old signatures stay dead.
  const prevNonce = _members.member(id) ? _members.lookup(id).nonce : 0 as Uint<64>;
  _members.insert(id, Member {
    pk: disclose(pk), payout: disclose(payout), checkpoint: _accPerShare, nonce: prevNonce,
    lastSeen: disclose(currentTime), registeredAt: disclose(currentTime), isLive: true,
  });
  _live = (_live + 1 as Uint<64>) as Uint<64>;
  _seenKycJobHashes.insert(disclose(kycHash));
  if (_pendingPrunes.member(id)) { _pendingPrunes.remove(id); }
  if (_pendingPayouts.member(id)) { _pendingPayouts.remove(id); }
  logEvent(pad(32, "pp:ld:v3:register"), id, disclose(payout).bytes, disclose(kycHash),
           u(disclose(currentTime)));
}

export circuit unregister(id: Bytes<32>, currentTime: Uint<64>): [] {
  notFuture(currentTime);
  requireCouncil(unregisterActionHash(kernel.self().bytes, disclose(id), disclose(currentTime)));
  const m = liveMember(id);
  sync();   // settle accrual at the old member count first
  const k = disclose(id);
  _members.insert(k, Member {
    pk: m.pk, payout: m.payout, checkpoint: m.checkpoint, nonce: m.nonce,
    lastSeen: m.lastSeen, registeredAt: m.registeredAt, isLive: false,
  });
  _live = (_live - 1 as Uint<64>) as Uint<64>;
  if (_pendingPrunes.member(k)) { _pendingPrunes.remove(k); }
  if (_pendingPayouts.member(k)) { _pendingPayouts.remove(k); }
  logEvent(pad(32, "pp:ld:v3:unregister"), k, pad(32, ""), pad(32, ""), u(disclose(currentTime)));
}

// --- member actions ---------------------------------------------------------------

export circuit claim(id: Bytes<32>, currentTime: Uint<64>, sig: JubjubSchnorrSignature): [] {
  notFuture(currentTime);
  const m = liveMember(id);
  checkMemberSig(m, id, pad(32, "claim"), timeDigest(disclose(currentTime)), sig);
  sync();

  const growth = (_accPerShare - m.checkpoint) as Uint<128>;
  const gF = growth as Field;
  const sF = SCALE() as Field;
  const owed = disclose(checkedDivide(gF, sF, witness_divmod(gF, sF)));

  const k = disclose(id);
  _members.insert(k, Member {
    pk: m.pk, payout: m.payout, checkpoint: _accPerShare, nonce: (m.nonce + 1 as Uint<64>) as Uint<64>,
    lastSeen: later(m.lastSeen, disclose(currentTime)), registeredAt: m.registeredAt, isLive: true,
  });
  if (_pendingPrunes.member(k)) { _pendingPrunes.remove(k); }

  if (owed > 0 as Uint<128>) {
    _totalClaimed = disclose((_totalClaimed + owed) as Uint<128>);
    _ebt.mintDividend(m.payout, owed);   // EBT checks the caller and its budget
    logEvent(pad(32, "pp:ld:v3:claim"), k, m.payout.bytes, u(owed), u(disclose(currentTime)));
  }
}

export circuit touchLiveness(id: Bytes<32>, currentTime: Uint<64>, sig: JubjubSchnorrSignature): [] {
  notFuture(currentTime);
  const m = liveMember(id);
  checkMemberSig(m, id, pad(32, "touchLiveness"), timeDigest(disclose(currentTime)), sig);
  const k = disclose(id);
  _members.insert(k, Member {
    pk: m.pk, payout: m.payout, checkpoint: m.checkpoint, nonce: (m.nonce + 1 as Uint<64>) as Uint<64>,
    lastSeen: later(m.lastSeen, disclose(currentTime)), registeredAt: m.registeredAt, isLive: true,
  });
  if (_pendingPrunes.member(k)) { _pendingPrunes.remove(k); }
}

// (c) payout-address change: member-signed, effective after 72 h.
export circuit requestPayoutChange(id: Bytes<32>, newPayout: UserAddress, currentTime: Uint<64>,
                                   sig: JubjubSchnorrSignature): [] {
  fresh(currentTime);
  const m = liveMember(id);
  checkMemberSig(m, id, pad(32, "requestPayoutChange"),
                 payoutDigest(disclose(newPayout), disclose(currentTime)), sig);
  const k = disclose(id);
  _members.insert(k, Member {
    pk: m.pk, payout: m.payout, checkpoint: m.checkpoint, nonce: (m.nonce + 1 as Uint<64>) as Uint<64>,
    lastSeen: m.lastSeen, registeredAt: m.registeredAt, isLive: true,
  });
  const effectiveAt = (disclose(currentTime) + PAYOUT_CHANGE_DELAY()) as Uint<64>;
  _pendingPayouts.insert(k, PendingPayout { payout: disclose(newPayout), effectiveAt: effectiveAt });
  logEvent(pad(32, "pp:ld:v3:payoutRequest"), k, disclose(newPayout).bytes,
           u(effectiveAt), u(disclose(currentTime)));
}

export circuit cancelPayoutChange(id: Bytes<32>, currentTime: Uint<64>, sig: JubjubSchnorrSignature): [] {
  notFuture(currentTime);
  const m = liveMember(id);
  checkMemberSig(m, id, pad(32, "cancelPayoutChange"), timeDigest(disclose(currentTime)), sig);
  const k = disclose(id);
  assert(_pendingPayouts.member(k), "No pending payout change");
  _pendingPayouts.remove(k);
  _members.insert(k, Member {
    pk: m.pk, payout: m.payout, checkpoint: m.checkpoint, nonce: (m.nonce + 1 as Uint<64>) as Uint<64>,
    lastSeen: m.lastSeen, registeredAt: m.registeredAt, isLive: true,
  });
  logEvent(pad(32, "pp:ld:v3:payoutCancel"), k, pad(32, ""), pad(32, ""), u(disclose(currentTime)));
}

// Council veto (e.g. a member's key is stolen and the thief requests a change).
export circuit councilCancelPayoutChange(id: Bytes<32>, currentTime: Uint<64>): [] {
  notFuture(currentTime);
  requireCouncil(cancelPayoutActionHash(kernel.self().bytes, disclose(id), disclose(currentTime)));
  const k = disclose(id);
  assert(_pendingPayouts.member(k), "No pending payout change");
  _pendingPayouts.remove(k);
  logEvent(pad(32, "pp:ld:v3:payoutCancel"), k, pad(32, "council"), pad(32, ""), u(disclose(currentTime)));
}

// Anyone may apply a change once its delay has passed (block time).
export circuit confirmPayoutChange(id: Bytes<32>): [] {
  const k = disclose(id);
  assert(_pendingPayouts.member(k), "No pending payout change");
  const p = _pendingPayouts.lookup(k);
  assert(disclose(blockTimeGte(p.effectiveAt)), "Payout change not yet effective");
  const m = liveMember(id);
  _members.insert(k, Member {
    pk: m.pk, payout: p.payout, checkpoint: m.checkpoint, nonce: m.nonce,
    lastSeen: m.lastSeen, registeredAt: m.registeredAt, isLive: true,
  });
  _pendingPayouts.remove(k);
  logEvent(pad(32, "pp:ld:v3:payoutSet"), k, p.payout.bytes, u(p.effectiveAt), pad(32, ""));
}

// --- inactivity pruning (permissionless, block-time gated) ---------------------------

export circuit proposePrune(id: Bytes<32>, currentTime: Uint<64>): [] {
  fresh(currentTime);   // a backdated proposal would shorten the member's grace period
  const m = liveMember(id);
  assert(disclose(currentTime) >= (m.lastSeen + INACTIVITY_THRESHOLD()) as Uint<64>,
         "Member is within the activity window");
  const k = disclose(id);
  assert(!_pendingPrunes.member(k), "Prune already pending");
  _pendingPrunes.insert(k, disclose(currentTime));
}

export circuit executePrune(id: Bytes<32>): [] {
  const k = disclose(id);
  assert(_pendingPrunes.member(k), "No pending prune");
  const proposedAt = _pendingPrunes.lookup(k);
  assert(disclose(blockTimeGte((proposedAt + PRUNE_GRACE_PERIOD()) as Uint<64>)),
         "Prune grace period not elapsed");
  const m = liveMember(id);
  _pendingPrunes.remove(k);
  if (m.lastSeen <= proposedAt) {
    sync();   // settle accrual at the old member count first
    _members.insert(k, Member {
      pk: m.pk, payout: m.payout, checkpoint: m.checkpoint, nonce: m.nonce,
      lastSeen: m.lastSeen, registeredAt: m.registeredAt, isLive: false,
    });
    _live = (_live - 1 as Uint<64>) as Uint<64>;
    if (_pendingPayouts.member(k)) { _pendingPayouts.remove(k); }
    logEvent(pad(32, "pp:ld:v3:prune"), k, pad(32, ""), u(proposedAt as Uint<128>), pad(32, ""));
  }
}
