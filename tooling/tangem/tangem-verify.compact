// WI-16 Tangem test: does a ring's secp256k1 signature over a 32-byte hash
// verify with the Compact stdlib secp256k1EcdsaVerify? Test contract only;
// never deployed to a public network.
pragma language_version 0.28;
import CompactStandardLibrary;

export ledger verified: Counter;

// Returns the verifier's answer (for offline runs that inspect both outcomes).
export circuit check(digest: Bytes<32>, sig: Secp256k1EcdsaSignature, pk: Secp256k1Point): Boolean {
  return disclose(secp256k1EcdsaVerify(disclose(digest), disclose(sig), disclose(pk)));
}

// Asserts verification and records it on chain (the local-devnet run).
export circuit verifyAndRecord(digest: Bytes<32>, sig: Secp256k1EcdsaSignature, pk: Secp256k1Point): [] {
  assert(secp256k1EcdsaVerify(disclose(digest), disclose(sig), disclose(pk)), "ring signature does not verify");
  verified.increment(1);
}
