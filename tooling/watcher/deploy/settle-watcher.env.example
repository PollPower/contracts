# /etc/pollpower/settle-watcher.env  (mode 0640, root:ppwatch). NO secrets here:
# the bot token and SMTP password are files under /etc/pollpower/secrets.
MIDNIGHT_NETWORK_ID=preprod
MIDNIGHT_NODE_URL=
MIDNIGHT_INDEXER_URL=
MIDNIGHT_PROOF_SERVER_URL=
EBT_ADDRESS=
EBT_BUILD_DIR=/opt/pollpower/contracts/build/l9/ebt-v8
WATCHER_STATE_FILE=/var/lib/pp-settle-watcher/state.json
WATCHER_INTERVAL_MS=60000

WATCHER_TELEGRAM_TOKEN_FILE=/etc/pollpower/secrets/telegram-bot-token
WATCHER_TELEGRAM_CHAT_ID=

WATCHER_EMAIL_FROM=
WATCHER_EMAIL_TO=garrett:ADDRESS,member1:ADDRESS,member2:ADDRESS
WATCHER_SMTP_HOST=
WATCHER_SMTP_PORT=465
WATCHER_SMTP_USER=
WATCHER_SMTP_PASSWORD_FILE=/etc/pollpower/secrets/smtp-password
