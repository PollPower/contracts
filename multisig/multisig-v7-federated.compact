// SPDX-License-Identifier: Apache-2.0
//
// PollPowerMultiSig v7 (DEV DRAFT) — Federated council with constitutional
// floor, epoch-bound sortition seats, and attested federation seats.
//
// Status:  DEV DRAFT — NOT deployed, NOT production. Design exploration for
//          the Fractal Federation (whitepaper section, 2026-07-07).
// Author:  Joi (with Garrett)
// Date:    2026-07-08
// Base:    multisig-v6.2-ed25519.compact (H-3 hardened)
// Design:  workspace/deliverables/fractal-federation.md — implements:
//            §1  Constitutional floor  (rule-changing ops need council quorum
//                AND a referendum attestation — the tree governs operations,
//                the membership governs the rules)
//            §7  Sortition / epoch-bound seats (approvals die at rotation;
//                seat sets are re-drawn wholesale against an auditable seed
//                commitment, never incrementally edited)
//            §8  Federation seats via attested-quorum witness (a seat may be
//                a lower-tier council contract; its approval enters through
//                a registered attestor co-signature — the Meter Authority
//                pattern, NOT a naive prover-trusted boolean)
//
// =============================================================================
// DESIGN NOTES (why this differs from v6.2)
// =============================================================================
//
// 1. FIXED COUNCIL OF 5, ROTATED — addAdmin/removeAdmin are REMOVED.
//    In the fractal model, councils are re-drawn by per-epoch sortition from
//    the tier's membership (fractal-federation §7: sortition converts
//    seat-capture back into membership-capture). Incremental add/remove is
//    the wrong primitive for that; executeRotateSeats replaces the whole
//    seat set atomically, binding a seedCommitment so the sortition draw is
//    auditable off-chain. This also structurally eliminates H-3 (unbounded
//    admin set): the set size is always exactly 5.
//
// 2. EPOCH-KEYED APPROVALS. Every approval is recorded under
//    hash(epoch ‖ actionHash) and every signature binds the epoch. Rotation
//    increments the epoch, so all pending approvals — and all signatures
//    collected under the old council — die instantly. No stale-quorum replay
//    across rotations.
//
// 3. CONSTITUTIONAL FLOOR (fractal-federation §1, §6). v6.2's strict-majority
//    rule guards each ring; it does NOT guard the tree — stacked majorities
//    compose to ~(1/2)^n of leaves for network capture. Therefore
//    rule-changing operations (threshold, constitutional authority) require
//    BOTH council quorum AND an Ed25519 attestation from the registered
//    constitutional authority that a network-wide member referendum passed.
//    Pilot: the authority is one service key (Meter Authority pattern).
//    Production: the authority key should itself be threshold-held, and the
//    referendum instrument is community-poll v2.
//
// 4. FEDERATION SEATS (fractal-federation §2b, §8). A seat id may be a
//    lower-tier council CONTRACT ADDRESS instead of a person's pubkey.
//    Compact cannot read another contract's state in-circuit, so the lower
//    tier's quorum enters as an ATTESTED observation: a registered attestor
//    key co-signs (seatId ‖ epoch ‖ actionHash) after observing on-chain
//    quorum at the lower tier. Trust bound: faking a cluster's approval
//    requires compromising that cluster's attestor key — strictly better
//    than a bare prover-trusted witness boolean, same bound as the shipped
//    Meter Authority. FROST aggregation is the horizon upgrade.
//
// 5. WITNESS TRUST (unchanged from v6.2): signature_valid is verified by the
//    off-chain prover; the contract pins WHICH key must have signed. A lying
//    prover can only impersonate the key it already holds.
//
// OPEN QUESTIONS (before this leaves DEV):
//   - Who approves rotation? Currently the sitting council (operational).
//     fractal-federation §4 suggests the PARENT tier should be able to
//     convene rotation of a dead council — needs a convene path that works
//     when the council itself cannot reach quorum. Not implemented here.
//   - Stale _attestors/_federated entries for rotated-out seats are inert
//     (approval paths require _seats membership) but never garbage-collected
//     (Compact sets cannot be iterated in-circuit). Acceptable? Document.
//   - Constitutional authority is a single key in this draft (pilot bound).
//
// =============================================================================

pragma language_version >= 0.16 && <= 0.22;

import CompactStandardLibrary;

// =============================================================================
// Witness: Ed25519 signature verification (same shape + trust bound as v6.2)
// =============================================================================
witness signature_valid(
  pubkey: Bytes<32>,
  messageHash: Bytes<32>,
  signature: Bytes<64>,
): Boolean;

// =============================================================================
// Ledger state
// =============================================================================

// Seat identifiers. Direct seat: an Ed25519 pubkey. Federation seat: the
// lower-tier council's contract address (32 bytes either way).
export ledger _seats: Set<Bytes<32>>;

// Which seat ids are federation seats (approve via attestor, not raw sig).
export ledger _federated: Set<Bytes<32>>;

// Federation seat -> attestor Ed25519 pubkey (the key that co-signs observed
// lower-tier quorum; Meter Authority pattern).
export ledger _attestors: Map<Bytes<32>, Bytes<32>>;

// Council threshold. Strict majority of the fixed 5 seats (>= 3).
export ledger _threshold: Uint<8>;

// Seat epoch. Incremented by rotation; kills all pending approvals.
export ledger _epoch: Counter;

// Nonce for action replay protection (unchanged from v6.2).
export ledger _nonce: Counter;

// Pending approvals: hash(epoch ‖ actionHash) -> set of approving seat ids.
export ledger _approvals: Map<Bytes<32>, Set<Bytes<32>>>;

// Constitutional authority pubkey (referendum attestation key).
export ledger _constitutionalAuthority: Bytes<32>;

// Initialization guard.
export ledger _initialized: Boolean;

// =============================================================================
// Internal helpers
// =============================================================================

// Approval-map key: binds the current epoch so rotation invalidates
// everything pending.
circuit approvalKey(actionHash: Bytes<32>): Bytes<32> {
  const epochBytes = (_epoch.read() as Field) as Bytes<32>;
  return persistentHash<Vector<2, Bytes<32>>>([epochBytes, actionHash]);
}

// Message a DIRECT seat signs: domain ‖ epoch ‖ actionHash. Epoch in the
// preimage means old-council signatures cannot be replayed post-rotation.
circuit directApprovalMsg(actionHash: Bytes<32>): Bytes<32> {
  const domain = persistentHash<Bytes<32>>(pad(32, "pp:msv7:approve:direct"));
  const epochBytes = (_epoch.read() as Field) as Bytes<32>;
  return persistentHash<Vector<3, Bytes<32>>>([domain, epochBytes, actionHash]);
}

// Message a federation seat's ATTESTOR signs: domain ‖ seatId ‖ epoch ‖
// actionHash. Binding seatId prevents one attestor key (if reused across
// clusters) from having its signature replayed for a different seat.
circuit federatedApprovalMsg(seatId: Bytes<32>, actionHash: Bytes<32>): Bytes<32> {
  const domain = persistentHash<Bytes<32>>(pad(32, "pp:msv7:approve:fed"));
  const epochBytes = (_epoch.read() as Field) as Bytes<32>;
  return persistentHash<Vector<4, Bytes<32>>>([domain, seatId, epochBytes, actionHash]);
}

// Message the CONSTITUTIONAL AUTHORITY signs to attest a passed referendum.
circuit constitutionalMsg(actionHash: Bytes<32>): Bytes<32> {
  const domain = persistentHash<Bytes<32>>(pad(32, "pp:msv7:constitutional"));
  const epochBytes = (_epoch.read() as Field) as Bytes<32>;
  return persistentHash<Vector<3, Bytes<32>>>([domain, epochBytes, actionHash]);
}

// =============================================================================
// Initialization — 5 seats, strict-majority threshold, authority key
// =============================================================================
export circuit initialize(
  seat1: Bytes<32>,
  seat2: Bytes<32>,
  seat3: Bytes<32>,
  seat4: Bytes<32>,
  seat5: Bytes<32>,
  threshold: Uint<8>,
  constitutionalAuthority: Bytes<32>,
): [] {
  assert(!_initialized, "Already initialized");
  assert(threshold > 0 as Uint<8>, "Threshold must be > 0");
  assert(threshold <= 5 as Uint<8>, "Threshold must be <= seat count (5)");
  // Strict-majority floor (v6.2 Fix 3): threshold*2 > 5  =>  threshold >= 3.
  assert((threshold as Uint<64>) * 2 as Uint<64> > 5 as Uint<64>,
         "Initial threshold must be a majority of the 5 seats");

  _seats.insert(disclose(seat1));
  _seats.insert(disclose(seat2));
  _seats.insert(disclose(seat3));
  _seats.insert(disclose(seat4));
  _seats.insert(disclose(seat5));
  // Duplicate guard: 5 distinct seats required.
  assert(_seats.size() == 5 as Uint<64>, "Initial seats must be 5 distinct ids");

  _threshold = disclose(threshold);
  _constitutionalAuthority = disclose(constitutionalAuthority);
  _initialized = disclose(true);
}

// =============================================================================
// Approve — direct seat (Ed25519, epoch-bound message)
// =============================================================================
export circuit approve(
  actionHash: Bytes<32>,
  signerPubkey: Bytes<32>,
  signature: Bytes<64>,
): [] {
  assert(_initialized, "Not initialized");

  const dSigner = disclose(signerPubkey);
  assert(_seats.member(dSigner), "Signer is not a seat");
  assert(!_federated.member(dSigner), "Federation seat must use approveFederated");

  const msg = directApprovalMsg(disclose(actionHash));
  const sigOk = signature_valid(signerPubkey, msg, signature);
  assert(disclose(sigOk), "Bad Ed25519 signature");

  const key = approvalKey(disclose(actionHash));
  if (!_approvals.member(key)) {
    _approvals.insertDefault(key);
  }
  _approvals.lookup(key).insert(dSigner);
}

// =============================================================================
// Approve — federation seat (attested lower-tier quorum; fractal-fed §8)
// =============================================================================
//
// The attestor observed threshold approval of the SAME actionHash at the
// lower-tier council contract (seatId), and co-signs that observation. The
// contract verifies the attestor is the one registered for this seat.
export circuit approveFederated(
  actionHash: Bytes<32>,
  seatId: Bytes<32>,
  attestorSignature: Bytes<64>,
): [] {
  assert(_initialized, "Not initialized");

  const dSeat = disclose(seatId);
  assert(_seats.member(dSeat), "Unknown seat");
  assert(_federated.member(dSeat), "Not a federation seat");

  const attestor = _attestors.lookup(dSeat);
  const msg = federatedApprovalMsg(dSeat, disclose(actionHash));
  const sigOk = signature_valid(attestor, msg, attestorSignature);
  assert(disclose(sigOk), "Bad attestor signature");

  const key = approvalKey(disclose(actionHash));
  if (!_approvals.member(key)) {
    _approvals.insertDefault(key);
  }
  _approvals.lookup(key).insert(dSeat);
}

// =============================================================================
// Read circuits
// =============================================================================

export circuit isSeat(account: Bytes<32>): Boolean {
  return _seats.member(disclose(account));
}

export circuit isFederatedSeat(account: Bytes<32>): Boolean {
  return _federated.member(disclose(account));
}

export circuit getThreshold(): Uint<8> {
  return _threshold;
}

export circuit getEpoch(): Uint<64> {
  return _epoch.read();
}

export circuit getNonce(): Uint<64> {
  return _nonce.read();
}

export circuit getApprovalCount(actionHash: Bytes<32>): Uint<64> {
  const key = approvalKey(disclose(actionHash));
  if (_approvals.member(key)) {
    return _approvals.lookup(key).size();
  }
  return 0 as Uint<64>;
}

export circuit isApproved(actionHash: Bytes<32>): Boolean {
  return getApprovalCount(actionHash) >= (_threshold as Uint<64>);
}

// =============================================================================
// Execute — generic operational action (council quorum only)
// =============================================================================
export circuit execute(actionHash: Bytes<32>): [] {
  assert(_initialized, "Not initialized");
  assert(isApproved(actionHash), "Not enough approvals");

  _approvals.remove(approvalKey(disclose(actionHash)));
  _nonce.increment(1);
}

// =============================================================================
// OPERATIONAL: register a federation seat's attestor
// =============================================================================
//
// Converts a seat into a federation seat (or updates its attestor). Council-
// approved: actionHash binds (seatId, attestorPubkey, nextNonce).
export circuit executeSetSeatAttestor(
  seatId: Bytes<32>,
  attestorPubkey: Bytes<32>,
): [] {
  assert(_initialized, "Not initialized");

  const dSeat = disclose(seatId);
  const dAttestor = disclose(attestorPubkey);
  assert(_seats.member(dSeat), "Unknown seat");

  const opSel = persistentHash<Bytes<32>>(pad(32, "pp:msv7:setSeatAttestor"));
  const nextNonce = (_nonce.read() + 1 as Uint<64>) as Field as Bytes<32>;
  const actionHash = persistentHash<Vector<4, Bytes<32>>>(
    [opSel, dSeat, dAttestor, nextNonce]);

  assert(isApproved(actionHash), "setSeatAttestor: not enough approvals");

  if (!_federated.member(dSeat)) {
    _federated.insert(dSeat);
  }
  _attestors.insert(dSeat, dAttestor);

  _approvals.remove(approvalKey(actionHash));
  _nonce.increment(1);
}

// =============================================================================
// OPERATIONAL: rotate the seat set (sortition epoch turn; fractal-fed §7)
// =============================================================================
//
// Replaces ALL 5 seats atomically. seedCommitment binds the sortition
// randomness (e.g. hash of a public beacon value + tier membership snapshot)
// so the draw is auditable off-chain: anyone can recompute the draw from the
// revealed seed and verify the incoming seats match it.
//
// Epoch increments, which invalidates every pending approval and every
// collected signature (epoch is in all signed preimages).
//
// NOTE (open question, header): rotation is approved by the SITTING council.
// A dead council (no quorum) cannot rotate itself — the §4 parent-convened
// recovery path is not implemented in this draft.
export circuit executeRotateSeats(
  outgoing: Vector<5, Bytes<32>>,
  incoming: Vector<5, Bytes<32>>,
  seedCommitment: Bytes<32>,
): [] {
  assert(_initialized, "Not initialized");

  const dOut = disclose(outgoing);
  const dIn = disclose(incoming);
  const dSeed = disclose(seedCommitment);

  const opSel = persistentHash<Bytes<32>>(pad(32, "pp:msv7:rotateSeats"));
  const nextNonce = (_nonce.read() + 1 as Uint<64>) as Field as Bytes<32>;
  const actionHash = persistentHash<Vector<13, Bytes<32>>>([
    opSel,
    dOut[0], dOut[1], dOut[2], dOut[3], dOut[4],
    dIn[0], dIn[1], dIn[2], dIn[3], dIn[4],
    dSeed,
    nextNonce,
  ]);

  assert(isApproved(actionHash), "rotateSeats: not enough approvals");

  // The outgoing vector must be exactly the current council.
  assert(_seats.member(dOut[0]), "rotateSeats: outgoing[0] not a seat");
  assert(_seats.member(dOut[1]), "rotateSeats: outgoing[1] not a seat");
  assert(_seats.member(dOut[2]), "rotateSeats: outgoing[2] not a seat");
  assert(_seats.member(dOut[3]), "rotateSeats: outgoing[3] not a seat");
  assert(_seats.member(dOut[4]), "rotateSeats: outgoing[4] not a seat");

  _seats.remove(dOut[0]);
  _seats.remove(dOut[1]);
  _seats.remove(dOut[2]);
  _seats.remove(dOut[3]);
  _seats.remove(dOut[4]);

  _seats.insert(dIn[0]);
  _seats.insert(dIn[1]);
  _seats.insert(dIn[2]);
  _seats.insert(dIn[3]);
  _seats.insert(dIn[4]);

  // Council is always exactly 5 distinct seats (also catches duplicate
  // outgoing entries: removing a dup twice leaves size > 5 after insert of
  // 5 distinct, or < 5 on duplicate incoming).
  assert(_seats.size() == 5 as Uint<64>, "rotateSeats: seat set must be 5 distinct ids");

  // Stale _federated/_attestors entries for rotated-out seats are inert:
  // both approval paths require _seats membership. Retained federation
  // seats keep their attestor across epochs.

  // New epoch: every pending approval and old-epoch signature dies here.
  _epoch.increment(1);

  _approvals.remove(approvalKey(actionHash));
  _nonce.increment(1);
}

// =============================================================================
// CONSTITUTIONAL: change threshold (council quorum + referendum attestation)
// =============================================================================
//
// fractal-federation §1: rule-changing operations bypass pure council power.
// The tree governs operations; the membership governs the rules. Threshold
// is a rule.
export circuit executeSetThreshold(
  newThreshold: Uint<8>,
  authoritySignature: Bytes<64>,
): [] {
  assert(_initialized, "Not initialized");
  assert(newThreshold > 0 as Uint<8>, "Threshold must be > 0");
  assert(newThreshold <= 5 as Uint<8>, "Threshold must be <= seat count (5)");
  // Strict-majority floor preserved (v6.2 Fix 4).
  assert((newThreshold as Uint<64>) * 2 as Uint<64> > 5 as Uint<64>,
         "Threshold must be a majority of the 5 seats");

  const dThreshold = disclose(newThreshold);
  const opSel = persistentHash<Bytes<32>>(pad(32, "pp:msv7:setThreshold"));
  const thresholdBytes = (dThreshold as Field) as Bytes<32>;
  const nextNonce = (_nonce.read() + 1 as Uint<64>) as Field as Bytes<32>;
  const actionHash = persistentHash<Vector<3, Bytes<32>>>(
    [opSel, thresholdBytes, nextNonce]);

  // Gate 1: council quorum.
  assert(isApproved(actionHash), "setThreshold: not enough approvals");

  // Gate 2: constitutional floor — referendum attestation.
  const msg = constitutionalMsg(actionHash);
  const sigOk = signature_valid(_constitutionalAuthority, msg, authoritySignature);
  assert(disclose(sigOk), "setThreshold: bad constitutional attestation");

  _threshold = dThreshold;

  _approvals.remove(approvalKey(actionHash));
  _nonce.increment(1);
}

// =============================================================================
// CONSTITUTIONAL: replace the constitutional authority key
// =============================================================================
//
// Dual-gated like setThreshold: the membership must attest (via the OLD
// authority) to handing the attestation power to a new key.
export circuit executeSetConstitutionalAuthority(
  newAuthority: Bytes<32>,
  authoritySignature: Bytes<64>,
): [] {
  assert(_initialized, "Not initialized");

  const dAuthority = disclose(newAuthority);
  const opSel = persistentHash<Bytes<32>>(pad(32, "pp:msv7:setConstAuthority"));
  const nextNonce = (_nonce.read() + 1 as Uint<64>) as Field as Bytes<32>;
  const actionHash = persistentHash<Vector<3, Bytes<32>>>(
    [opSel, dAuthority, nextNonce]);

  // Gate 1: council quorum.
  assert(isApproved(actionHash), "setConstAuthority: not enough approvals");

  // Gate 2: referendum attestation under the OLD authority key.
  const msg = constitutionalMsg(actionHash);
  const sigOk = signature_valid(_constitutionalAuthority, msg, authoritySignature);
  assert(disclose(sigOk), "setConstAuthority: bad constitutional attestation");

  _constitutionalAuthority = dAuthority;

  _approvals.remove(approvalKey(actionHash));
  _nonce.increment(1);
}
