// SPDX-License-Identifier: Apache-2.0
//
// PollPowerMultiSig v8: council approvals with in-circuit secp256k1 (WI-16)
//
// =============================================================================
// WHY v8
// =============================================================================
// WI16-C-1: every council check up to v7 was `assert(disclose(witness(...)))`.
// A witness is prover-supplied, so a prover could answer `true` for a forged
// signature; the 2026-11-23 PoC reached 3-of-5 on v6.2 with no private key.
// v8 verifies each approval in the circuit with the stdlib
// `secp256k1EcdsaVerify`, so the proof itself shows a council key signed.
// This contract has NO witnesses.
//
// Keys are secp256k1, held on the Tangem rings (verified 2026-11-24: the ring
// signs the 32-byte digest as given, raw r||s; compressed keys are expanded
// off-chain). Design: docs/design/WI16-auth-fix-design.md, "C-1a".
//
// =============================================================================
// WHAT AN ADMIN SIGNS
// =============================================================================
//   digest = persistentHash<Vector<4, Bytes<32>>>([
//              pad(32, "pp:ms:v8:approve"), <this contract's address>,
//              actionHash, epoch as Field as Bytes<32> ])
// `approvalDigest` is an exported pure circuit, so the admin app computes the
// same bytes with the compiled contract. The address keeps M-2's domain
// separation; `epoch` is the council generation (0 until rotation exists).
//
// Consumers (EBT, TariffRegistry, Living Dividend) build `actionHash` with
// their own domain tag and address, ask `isApproved(actionHash)` through a
// cross-contract call, and keep their own replay record. There is no generic
// `execute` here: an approval is consumed where it is used.
//
// =============================================================================
// COUNCIL: SEALED FOR THE NOV 30 DEVNET DEMO
// =============================================================================
// The council is fixed by the constructor (H-1: no first-caller initialize).
// Rotation (72 h delay, approval per (actionHash, adminIndex), epoch bump) is
// designed and is a PREPROD GATE: this version must not go to Preprod.

pragma language_version 0.28;

import CompactStandardLibrary;

// H-3: hard cap on council size.
export pure circuit maxAdmins(): Uint<8> {
  return 7;
}

// =============================================================================
// Ledger state
// =============================================================================

// Council keys by slot index 0..adminCount-1.
export sealed ledger _adminPks: Map<Uint<8>, Secp256k1Point>;
// persistentHash of each council key; rejects duplicates in the constructor.
export sealed ledger _keyIds: Set<Bytes<32>>;
export sealed ledger _adminCount: Uint<8>;
export sealed ledger _threshold: Uint<8>;
// Council generation. Stays 0 while the council is sealed; part of every
// digest and approval key so rotation can invalidate old approvals.
export ledger _epoch: Counter;
// approvalKey(actionHash, epoch) -> council slots that approved.
// Recorded per (actionHash, adminIndex), never per signature: the circuit
// accepts both (r, s) and (r, n - s).
export ledger _approvals: Map<Bytes<32>, Set<Uint<8>>>;

// =============================================================================
// Digests
// =============================================================================

export pure circuit approvalDigest(self: Bytes<32>, actionHash: Bytes<32>, epoch: Uint<64>): Bytes<32> {
  return persistentHash<Vector<4, Bytes<32>>>([
    pad(32, "pp:ms:v8:approve"), self, actionHash, (epoch as Field) as Bytes<32>,
  ]);
}

pure circuit approvalKey(actionHash: Bytes<32>, epoch: Uint<64>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>([
    pad(32, "pp:ms:v8:approvalKey"), actionHash, (epoch as Field) as Bytes<32>,
  ]);
}

// =============================================================================
// Constructor (H-1 + H-3)
// =============================================================================
// Slots 0..adminCount-1 of `adminPks` are the council; later slots are ignored.

circuit installSlot(i: Uint<8>, pk: Secp256k1Point, n: Uint<8>): [] {
  if (i < n) {
    const id = disclose(persistentHash<Secp256k1Point>(pk));
    assert(!_keyIds.member(id), "duplicate council key");
    _keyIds.insert(id);
    _adminPks.insert(i, disclose(pk));
  }
}

constructor(adminPks: Vector<7, Secp256k1Point>, adminCount: Uint<8>, threshold: Uint<8>) {
  const n = disclose(adminCount);
  const t = disclose(threshold);
  assert(n >= 1 && n <= maxAdmins(), "admin count must be between 1 and 7");
  assert(t > 0, "Threshold must be > 0");
  assert(t <= n, "Threshold must be <= admin count");
  assert((t as Uint<16>) * 2 > (n as Uint<16>), "Threshold must be a majority of the council");

  installSlot(0, adminPks[0], n);
  installSlot(1, adminPks[1], n);
  installSlot(2, adminPks[2], n);
  installSlot(3, adminPks[3], n);
  installSlot(4, adminPks[4], n);
  installSlot(5, adminPks[5], n);
  installSlot(6, adminPks[6], n);

  _adminCount = n;
  _threshold = t;
}

// =============================================================================
// Approve: secp256k1 signature verified in the circuit
// =============================================================================

export circuit approve(actionHash: Bytes<32>, adminIndex: Uint<8>, sig: Secp256k1EcdsaSignature): [] {
  const i = disclose(adminIndex);
  assert(i < _adminCount, "not a council slot");
  const h = disclose(actionHash);
  const epoch = _epoch.read();
  const digest = approvalDigest(kernel.self().bytes, h, epoch);
  assert(secp256k1EcdsaVerify(digest, disclose(sig), _adminPks.lookup(i)), "bad council signature");

  const k = approvalKey(h, epoch);
  if (!_approvals.member(k)) {
    _approvals.insertDefault(k);
  }
  assert(!_approvals.lookup(k).member(i), "already approved");
  _approvals.lookup(k).insert(i);
}

// =============================================================================
// Reads. Witness-free, so other contracts can call them.
// =============================================================================

export circuit getApprovalCount(actionHash: Bytes<32>): Uint<64> {
  const k = approvalKey(disclose(actionHash), _epoch.read());
  if (_approvals.member(k)) {
    return _approvals.lookup(k).size();
  }
  return 0;
}

export circuit isApproved(actionHash: Bytes<32>): Boolean {
  return getApprovalCount(actionHash) >= (_threshold as Uint<64>);
}

export circuit getThreshold(): Uint<8> {
  return _threshold;
}

export circuit getAdminCount(): Uint<8> {
  return _adminCount;
}
