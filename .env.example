# PollPower contracts tooling — environment template (WI-16, ledger 9).
# Copy to .env (gitignored) or export in your shell. Never commit real values.
#
# Endpoints: point at the node host's self-hosted Preprod stack over the private network once
# Joi posts them in docs/infra-status.md. Nothing is hardcoded in the tooling.

# --- network (tooling/midnight-network.mjs) -------------------------------
MIDNIGHT_NETWORK_ID=preprod
MIDNIGHT_INDEXER_URL=http://<node-host>:8088/api/v4/graphql
MIDNIGHT_NODE_URL=http://<node-host>:9944
# Optional (derived from the two above when unset):
# MIDNIGHT_INDEXER_WS_URL=ws://<node-host>:8088/api/v4/graphql/ws
# MIDNIGHT_NODE_WS_URL=ws://<node-host>:9944
# MIDNIGHT_PROOF_SERVER_URL=http://127.0.0.1:6300
# MIDNIGHT_TX_TTL_SECONDS=3600

# --- secrets supplied at run time (never committed) -----------------------
# MIDNIGHT_PRIVATE_STATE_PASSWORD=   # level private-state store password
# OWNER_SEED=                        # settle-flow owner wallet master seed (hex)

# --- contracts and builds (ebt/settle-flow/env.mjs) -----------------------
# EBT_ADDRESS=                       # 64-hex, after the Preprod deploy
# REGISTRY_ADDRESS=                  # 64-hex, after the Preprod deploy
# EBT_BUILD_DIR=build/l9/ebt-v8                   # default
# REGISTRY_BUILD_DIR=build/l9/tariff-registry-v1  # default
# OPERATOR_PEM=                      # retune.mjs schedule operator key (PEM path)

# --- tariff-registry scripts ----------------------------------------------
# TARIFF_ROOT=                       # default: the tariff-registry directory
# RECIPIENT_KEYS_PATH=               # default: ebt/ceremony/recipient-keys.json

# --- compiler (tooling/build-contracts.mjs) -------------------------------
# COMPACT_BIN=                       # Windows: path to ~/bin/compact.cmd (WSL shim)
