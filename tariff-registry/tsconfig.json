{
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "es2022",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "checkJs": false,
    "noEmit": true
  },
  "include": ["deploy/**/*.ts", "*.ts"],
  "exclude": [
    "node_modules",
    "deploy-tariff-registry-preview.ts",
    "deploy/deploy-wi15.1.ts"
  ]
}
