// SPDX-License-Identifier: Apache-2.0
//
// PollPowerTariffRegistry v1 (DEV DRAFT) — epoch-versioned tariff schedule
//                                          registry, chartered-node only.
//
// Author:  Joi (with Garrett)
// Date:    2026-07-14
// Design:  ../tariff-registry/V1-DESIGN.md
// Brief:   ../dispatch-briefs/WI-13-TariffRegistry.md
// Memo:    ../dispatch-briefs/WI-13-DISPATCH-MEMO-2026-07-14.md
// Plan:    ../FEDERATION-IMPLEMENTATION-PLAN.md §0.1, §0.2, §0.3
// Tooling: compactc 0.30.0, language 0.22.0, runtime 0.15.0 — per Garrett's
//          written call 2026-07-14 22:57 JST. 0.31.0 upgrade gap deferred
//          to WI-13.1 (V1-DESIGN.md §11).
//
// =============================================================================
// WHAT THIS CONTRACT IS
// =============================================================================
//
// The on-chain source of truth for tariff schedules. WI-14 settlement reads
// resolvePath / resolveCurrent; the registry never mints, holds custody, or
// gates settlement itself. It publishes structured, versioned, federation-
// vetted schedules against which downstream contracts settle.
//
//   Companies price     → retuneClass          (leaf op, un-gated by design)
//   Members bound       → register/retire/     (branch ops, federation-gated
//                         advanceEpoch/etc      via multisig_signature_valid)
//   The mint pays       → NOTHING HERE          (I-F: no value primitives)
//
// =============================================================================
// COMPACT 0.30.0 IDIOMS MIRRORED FROM EBT V7.4.2 AND LD V2.2.1
// =============================================================================
//
//   * `witness signature_valid(pubkey, msgHash, sig): Boolean` — Ed25519,
//     shared shape with EBT/LD/msfed. Used for validator attestor + operator
//     retune signatures.
//
//   * `witness multisig_signature_valid(payload, authorityHash): Boolean` —
//     shared shape with EBT v7.4.2 (L138–L143) and LD v2.2.1. The off-chain
//     prover reconstructs the msfed council bundle (3-of-5 seat approvals,
//     direct or approveFederated attested); the witness returns Boolean; we
//     assert. The registry does NOT reproduce msfed's own signing-message
//     shapes in-circuit.
//
//   * `witness charter_membership_proof(nodeId): CharterProof` — R-A
//     structural fix (V1-DESIGN.md §4.1). Returns a Merkle-inclusion proof
//     structure, NOT a Boolean, so a lying prover cannot forge a truthy
//     answer. We reconstruct the root from (nodeId, siblings, indices) and
//     assert equality with _governanceRoot.
//
//   * `witness witness_divmod(numerator, divisor): DivResult` + checkedDivide
//     — copied from LD v2.2.1 L197–L203. Sanity-band re-check on retune
//     (T3.5) needs an in-circuit divide; this is the only path.
//
//   * Every inequality is a checked cast (LD/EBT pattern). E.g.
//       `(effectiveEpoch - _currentEpoch.read() - 1) as Uint<64>`
//     reverts at runtime on underflow. No Field ordering ops.
//
//   * Every witness→ledger write uses `disclose()`.
//
//   * Sealed calibration constants (LD_FLOOR_BPS, OPS_FLOOR_BPS,
//     SANITY_BAND_PCT) set in constructor(), never mutable except via
//     shadow-and-swap during advanceEpoch (setNationalContext writes the
//     shadow trio).
//
// =============================================================================
// THE FEDERATION-GATED SETTER PATTERN
// =============================================================================
//
// Every branch op follows this skeleton (matches EBT v7.4.2 execMultisigOp):
//
//   1. assertInitialized(); blockTimeGte check.
//   2. Compute actionHash = persistentHash<Vector<N, Bytes<32>>>([
//        domainTag,           // e.g. pad(32, "pp:tariff:v1:registerSchedule")
//        kernel.self().bytes, // M-2 self-binding
//        ...op-specific params...,
//        currentEpochBytes,   // I-E epoch binding
//      ])
//   3. Assert !_consumedFederationApprovals.member(actionHash)  (I-D replay).
//   4. Assert disclose(multisig_signature_valid(actionHash,
//        _federationAuthority)).                                  (I-D verify).
//   5. Perform state mutation with disclose() on every witness-derived write.
//   6. Insert actionHash into _consumedFederationApprovals.
//   7. Emit RegistryActionEntry via _actionLog.
//
// =============================================================================

pragma language_version >= 0.16 && <= 0.22;

import CompactStandardLibrary;

// =============================================================================
// Constants (compile-time; NOT calibration values, which live in ledger)
// =============================================================================

// Merkle-inclusion depth for charter membership proofs. 12 supports 4096
// chartered nodes — ample for country-scale (V1-DESIGN.md §9.1).
pure circuit CHARTER_DEPTH(): Uint<64> {
  return 12 as Uint<64>;
}

// Retune cooldown (per-operator, per-schedule, per-epoch). Not a rate limit —
// retunes are permissionless within bounds — but a minimum time between two
// retunes ON THE SAME CLASS BY THE SAME OPERATOR to give the market a
// beat between price signals. 60 seconds is enough to matter operationally
// without impeding an operator's ability to correct a mistake.
pure circuit RETUNE_MIN_INTERVAL_S(): Uint<64> {
  return 60 as Uint<64>;
}

// =============================================================================
// Witnesses
// =============================================================================

// Ed25519 sig verify — same shape as EBT/LD/msfed.
witness signature_valid(
  pubkey: Bytes<32>,
  messageHash: Bytes<32>,
  signature: Bytes<64>,
): Boolean;

// Multisig bundle verify — same shape as EBT v7.4.2 / LD v2.2.1. Off-chain
// prover reconstructs a msfed 3-of-5 approval bundle over `payload`; returns
// Boolean.
witness multisig_signature_valid(
  payload:       Bytes<32>,
  authorityHash: Bytes<32>,
): Boolean;

// R-A structural fix. Returns a Merkle-inclusion proof (data, not truth):
// the prover CANNOT forge a proof against a root it did not construct.
// The circuit reconstructs the root from (nodeId, siblings, indices) and
// asserts equality with _governanceRoot.
witness charter_membership_proof(
  nodeId: Bytes<32>,
): CharterProof;

// Witness divmod, for checkedDivide (copied from LD v2.2.1).
witness witness_divmod(numerator: Field, divisor: Field): DivResult;

// WI-13.2: action-log Merkle append path. Returns the LSB-first bits of the
// leaf position `seq` (bit i = level-i left/right choice). The witness is
// prover-supplied *data*, not truth — appendActionLogLeaf reconstructs `seq`
// from the returned bits (two-sided checked cast) and reverts on any mismatch,
// so a lying prover cannot misplace a leaf. Width = ACTION_LOG_DEPTH (24).
witness action_log_path_bits(seq: Uint<64>): Vector<24, Boolean>;

// =============================================================================
// Structs
// =============================================================================

// Charter Merkle-inclusion proof.
struct CharterProof {
  siblings: Vector<12, Bytes<32>>,   // CHARTER_DEPTH sibling hashes
  indices:  Vector<12, Boolean>,     // left/right at each level
}

// Retune split payload (WI-07 sum-to-10000 in bps).
struct SplitShares {
  producerShareBps:  Uint<16>,
  ldShareBps:        Uint<16>,
  opsShareBps:       Uint<16>,
  daoShareBps:       Uint<16>,
  operatorMarginBps: Uint<16>,
  statutoryTotalBps: Uint<16>,
}

// Per-class ledger entry: split bps AND per-class fiat rate. WI-06 §5.5:
// retuneClass MAY update either. The sanity band (C1, TARIFF-SCHEDULE-MODEL
// §4.4a) is checked against rateFiatPerKwh, not the bps — F-5 T3.5 exercises
// this rate-side check on retune (not just at registration).
struct ClassEntry {
  bps:               SplitShares,
  rateFiatPerKwh:    Uint<64>,
  lastUpdatedAt:     Uint<64>,
}

// One row in _registeredSchedules.
struct ScheduleRecord {
  scheduleId:      Bytes<32>,
  nodeId:          Bytes<32>,
  scheduleHash:    Bytes<32>,   // WI-06 §3 canonical serialization hash
  operatorPubkey:  Bytes<32>,   // signer for future retuneClass calls
  effectiveEpoch:  Uint<64>,
  retiredEpoch:    Uint<64>,    // 0 = live; nonzero = retired at that epoch
  refRateFiatPerKwh: Uint<64>,  // sanity-band center for this schedule
  registeredAt:    Uint<64>,    // block time
}

// Event log entry.
//
// WI-13.2 widens this with `payloadHash` (additive; struct order preserved for
// kind/scheduleId/nodeId/epoch/actionHash/emittedAt). `actionHash` keeps its
// exact WI-13/13.1 meaning (federation/operator AUTHORIZATION commitment,
// non-invertible). `payloadHash` is a NEW, DISTINCT canonical commitment over
// the mirror-relevant event body (§SCOPE B) — the two are never conflated.
struct RegistryActionEntry {
  kind:        Uint<8>,     // 0..7 per V1-DESIGN.md §3.1 (+ WI-13.1 lane kinds)
  scheduleId:  Bytes<32>,   // 0 if not schedule-scoped
  nodeId:      Bytes<32>,   // 0 if not node-scoped
  epoch:       Uint<64>,    // registry epoch at time of action
  actionHash:  Bytes<32>,   // UNCHANGED — authorization commitment
  emittedAt:   Uint<64>,    // block time
  payloadHash: Bytes<32>,   // WI-13.2 NEW — canonical mirror-payload commitment
                            //   (pad(32,"") sentinel for non-mirrored kinds
                            //   4/5/6 and pre-amendment entries — §SCOPE A/F)
}

// checkedDivide return (copied from LD v2.2.1).
struct DivResult {
  quotient:  Uint<128>,
  remainder: Uint<128>,
}

// WI-13.1: Statutory lane record (V1.1-DESIGN.md §2.1).
struct LaneRecord {
  scheduleId:        Bytes<32>,
  laneKindByte:      Uint<8>,
  leviedBy:          Bytes<32>,
  bpsShare:          Uint<16>,
  remitAddress:      Bytes<32>,
  basis:             Uint<8>,
  applicabilityHash: Bytes<32>,
  statuteRefHash:    Bytes<32>,
  effectiveEpoch:    Uint<64>,
  retiredEpoch:      Uint<64>,
  remittanceMode:    Uint<8>,
  registeredAt:      Uint<64>,
}

// =============================================================================
// Ledger state
// =============================================================================

// Initialization guard.
export sealed ledger _initialized: Boolean;
// Constructor-run marker stays sealed (LD v2.2.1 pattern). Runtime readiness
// (post-deploy action-log bootstrap complete) is tracked separately.
export ledger _bootstrapComplete: Boolean;

// Federation multisig authority hash (SHA-256 of sorted seat pubkeys of the
// tier whose approval gates branch ops). Rotatable via setFederationAuthority
// (federation-gated).
export ledger _federationAuthority: Bytes<32>;

// Calibration constants — Garrett's 2026-07-14 written call
// (CALIBRATION-DECISIONS-RESOLVED-2026-07-14.md). Not `sealed` because
// advanceEpoch swaps in shadow values from setNationalContext (WI-06 §6).
export ledger _LD_FLOOR_BPS:    Uint<16>;   // = 200  (2.00%)
export ledger _OPS_FLOOR_BPS:   Uint<16>;   // = 2000 (20.00%)
export ledger _SANITY_BAND_PCT: Uint<16>;   // = 20   (±20%)

// Pending (shadow) national context. setNationalContext writes here; the
// next advanceEpoch atomically swaps it into the sealed slots. Zero values
// = "no pending change." WI-06 §6: floor changes never invalidate an
// already-accepted schedule mid-epoch.
export ledger _pendingLDFloorBps:    Uint<16>;
export ledger _pendingOpsFloorBps:   Uint<16>;
export ledger _pendingSanityBandPct: Uint<16>;
export ledger _hasPendingContext:    Boolean;

// Monotone epoch. Advances by EXACTLY 1 per advanceEpoch (F-7).
export ledger _currentEpoch: Counter;

// National reference rate anchoring the sanity band (recentered on
// advanceEpoch).
export ledger _refRateFiatPerKwh: Uint<64>;

// R-A: governance-tree charter Merkle root. Rotated only via advanceEpoch.
export ledger _governanceRoot: Bytes<32>;

// scheduleId → ScheduleRecord.
export ledger _registeredSchedules: Map<Bytes<32>, ScheduleRecord>;

// nodeId → active scheduleId at CURRENT epoch.
export ledger _activeScheduleByNode: Map<Bytes<32>, Bytes<32>>;

// scheduleId + classPathHash → current ClassEntry.
export ledger _classEntries: Map<Bytes<32>, ClassEntry>;

// WI-13.1: (scheduleId, laneKindByte) composite key → LaneRecord.
// Keeper-observable via _actionLog kind ∈ {1 LANE_REGISTERED, 7 LANE_RETIRED}.
// WI-14's settle circuit calls resolveLanes to route statutory shares in-circuit.
export ledger _registeredLanes: Map<Bytes<32>, LaneRecord>;

// R-B: per-(operator, schedule, epoch) nonce.
export ledger _retuneNonces: Map<Bytes<32>, Uint<64>>;

// R-B: last-retune-time per (operator, schedule, class), for cooldown.
export ledger _retuneLastTime: Map<Bytes<32>, Uint<64>>;

// I-D replay guard: federation actionHashes already consumed.
export ledger _consumedFederationApprovals: Set<Bytes<32>>;

// Event log (MIP-0002 pattern — keeper-observable).
export ledger _actionLog: Map<Uint<64>, RegistryActionEntry>;
export ledger _actionSeq: Counter;

// =============================================================================
// WI-13.2 action-log commitment (§SCOPE C)
// =============================================================================
//
// Append-only incremental Merkle tree over the per-entry `payloadHash` leaves,
// fixed depth ACTION_LOG_DEPTH. Leaf at position `seq` = the entry's raw
// `payloadHash` (NOT re-hashed — design decision #4, so WI-14's reconstructRoot
// climbs directly from proof.payloadHash). Updated on EVERY emitAction (all
// kinds; only the *payload* is kind-selective). WI-14's EventProof
// (VNEXT-DESIGN §7.1) generates fixed-width inclusion proofs against this root.

// The committed root over the action-log leaves. Empty-tree root at init.
export ledger registryActionLogRoot: Bytes<32>;

// Frontier: rightmost filled node cached at each level (incremental-tree
// bookkeeping). Keyed by level 0..ACTION_LOG_DEPTH-1. Initialized to the
// per-level empty-subtree hash in the constructor so lookups never miss.
// (Map, not ledger Vector — same incremental-Merkle scheme; Map is the
// proven container idiom in this codebase. See §DECISIONS in the PR body.)
export ledger _actionLogFrontier: Map<Uint<64>, Bytes<32>>;

// Precomputed empty-subtree hash at each level 0..ACTION_LOG_DEPTH-1
// (zeros[0] = empty-leaf tag; zeros[i] = node(zeros[i-1], zeros[i-1])).
export ledger _actionLogZeros: Map<Uint<64>, Bytes<32>>;

// §SCOPE F: the first seq at which payloadHash is populated + committed to the
// root. Fresh init = 0. Forward-only migration = the head at amendment time.
// WI-14 keepers use this to know where the mirrorable range starts.
export ledger _actionLogBaseSeq: Uint<64>;

// Transient climb accumulator for the Merkle fold (read-modify-write inside a
// bounded for-loop, per the documented Compact ledger-in-loop pattern). Holds
// no cross-call meaning; reset to the leaf at the start of every append. Kept
// as an exported ledger cell only because a for-loop accumulator must live in
// ledger state (locals are immutable across iterations); NOT part of the
// WI-14-facing surface.
export ledger _actionLogClimb: Bytes<32>;

// WI-13.3 bootstrap cursor for sharded action-log initialization.
// Semantics: levels in [cursor, shardEnd) are processed each call; cursor then
// becomes shardEnd. Terminal shardEnd == 24 finishes bootstrap readiness.
export ledger _actionLogBootstrapCursor: Uint<64>;

// =============================================================================
// Helpers
// =============================================================================

circuit assertInitialized(): [] {
  assert(_initialized, "TariffRegistry: not initialized");
  assert(_bootstrapComplete, "TariffRegistry: bootstrap incomplete");
}

circuit selfBytes(): Bytes<32> {
  return disclose(kernel.self()).bytes;
}

// Canonical hash of a SplitShares payload (used in retune sig hash).
circuit splitSharesHash(s: SplitShares): Bytes<32> {
  const dS = disclose(s);
  const b0 = (dS.producerShareBps  as Field) as Bytes<32>;
  const b1 = (dS.ldShareBps        as Field) as Bytes<32>;
  const b2 = (dS.opsShareBps       as Field) as Bytes<32>;
  const b3 = (dS.daoShareBps       as Field) as Bytes<32>;
  const b4 = (dS.operatorMarginBps as Field) as Bytes<32>;
  const b5 = (dS.statutoryTotalBps as Field) as Bytes<32>;
  return persistentHash<Vector<7, Bytes<32>>>([
    pad(32, "pp:tariff:v1:splitShares"),
    b0, b1, b2, b3, b4, b5,
  ]);
}

// Compound nonce key for R-B (per-operator/schedule/epoch).
circuit retuneNonceKey(
  operatorId: Bytes<32>,
  scheduleId: Bytes<32>,
): Bytes<32> {
  const epochBytes = (_currentEpoch.read() as Field) as Bytes<32>;
  return persistentHash<Vector<4, Bytes<32>>>([
    pad(32, "pp:tariff:v1:retuneNonce"),
    disclose(operatorId),
    disclose(scheduleId),
    epochBytes,
  ]);
}

// Composite key for retune cooldown (per-operator/schedule/class).
circuit retuneCooldownKey(
  operatorId: Bytes<32>,
  scheduleId: Bytes<32>,
  classPath:  Bytes<32>,
): Bytes<32> {
  return persistentHash<Vector<4, Bytes<32>>>([
    pad(32, "pp:tariff:v1:retuneCooldown"),
    disclose(operatorId),
    disclose(scheduleId),
    disclose(classPath),
  ]);
}

// Composite key for a class's split entry.
circuit classSplitKey(
  scheduleId: Bytes<32>,
  classPath:  Bytes<32>,
): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>([
    pad(32, "pp:tariff:v1:classSplitKey"),
    disclose(scheduleId),
    disclose(classPath),
  ]);
}

// WI-13.1: Composite key for a statutory lane record
// (scheduleId, leviedBy, laneKindByte). The leviedBy component makes
// multi-authority same-kind lanes representable (e.g. KRA-VAT and
// county-VAT as two distinct lanes on the same schedule).
// V1.1-DESIGN.md §2.3.
circuit laneKey(
  scheduleId:   Bytes<32>,
  leviedBy:     Bytes<32>,
  laneKindByte: Uint<8>,
): Bytes<32> {
  const kindBytes = (disclose(laneKindByte) as Field) as Bytes<32>;
  return persistentHash<Vector<4, Bytes<32>>>([
    pad(32, "pp:tariff:v1:laneKey"),
    disclose(scheduleId),
    disclose(leviedBy),
    kindBytes,
  ]);
}

// R-A: reconstruct the Merkle root from (leaf, proof) and assert it matches
// _governanceRoot. Fixed depth CHARTER_DEPTH = 12.
circuit assertCharterMembership(nodeId: Bytes<32>, proof: CharterProof): [] {
  const dSiblings = disclose(proof.siblings);
  const dIndices  = disclose(proof.indices);

  // Level 0: leaf hash of the nodeId (domain-separated).
  const leaf = persistentHash<Vector<2, Bytes<32>>>([
    pad(32, "pp:fed:charter:leaf"),
    disclose(nodeId),
  ]);

  // Fixed unroll of 12 levels. At each level: if indices[i] is false, the
  // node is the LEFT child and sibling is right; otherwise sibling-left,
  // node-right. Pair-hash with domain sep.
  const pairDomain = pad(32, "pp:fed:charter:node");

  const h0 = leaf;
  const h1 = dIndices[0]
    ? persistentHash<Vector<3, Bytes<32>>>([pairDomain, dSiblings[0], h0])
    : persistentHash<Vector<3, Bytes<32>>>([pairDomain, h0, dSiblings[0]]);
  const h2 = dIndices[1]
    ? persistentHash<Vector<3, Bytes<32>>>([pairDomain, dSiblings[1], h1])
    : persistentHash<Vector<3, Bytes<32>>>([pairDomain, h1, dSiblings[1]]);
  const h3 = dIndices[2]
    ? persistentHash<Vector<3, Bytes<32>>>([pairDomain, dSiblings[2], h2])
    : persistentHash<Vector<3, Bytes<32>>>([pairDomain, h2, dSiblings[2]]);
  const h4 = dIndices[3]
    ? persistentHash<Vector<3, Bytes<32>>>([pairDomain, dSiblings[3], h3])
    : persistentHash<Vector<3, Bytes<32>>>([pairDomain, h3, dSiblings[3]]);
  const h5 = dIndices[4]
    ? persistentHash<Vector<3, Bytes<32>>>([pairDomain, dSiblings[4], h4])
    : persistentHash<Vector<3, Bytes<32>>>([pairDomain, h4, dSiblings[4]]);
  const h6 = dIndices[5]
    ? persistentHash<Vector<3, Bytes<32>>>([pairDomain, dSiblings[5], h5])
    : persistentHash<Vector<3, Bytes<32>>>([pairDomain, h5, dSiblings[5]]);
  const h7 = dIndices[6]
    ? persistentHash<Vector<3, Bytes<32>>>([pairDomain, dSiblings[6], h6])
    : persistentHash<Vector<3, Bytes<32>>>([pairDomain, h6, dSiblings[6]]);
  const h8 = dIndices[7]
    ? persistentHash<Vector<3, Bytes<32>>>([pairDomain, dSiblings[7], h7])
    : persistentHash<Vector<3, Bytes<32>>>([pairDomain, h7, dSiblings[7]]);
  const h9 = dIndices[8]
    ? persistentHash<Vector<3, Bytes<32>>>([pairDomain, dSiblings[8], h8])
    : persistentHash<Vector<3, Bytes<32>>>([pairDomain, h8, dSiblings[8]]);
  const h10 = dIndices[9]
    ? persistentHash<Vector<3, Bytes<32>>>([pairDomain, dSiblings[9], h9])
    : persistentHash<Vector<3, Bytes<32>>>([pairDomain, h9, dSiblings[9]]);
  const h11 = dIndices[10]
    ? persistentHash<Vector<3, Bytes<32>>>([pairDomain, dSiblings[10], h10])
    : persistentHash<Vector<3, Bytes<32>>>([pairDomain, h10, dSiblings[10]]);
  const root = dIndices[11]
    ? persistentHash<Vector<3, Bytes<32>>>([pairDomain, dSiblings[11], h11])
    : persistentHash<Vector<3, Bytes<32>>>([pairDomain, h11, dSiblings[11]]);

  assert(root == _governanceRoot, "SCHEDULE_UNCHARTERED_NODE");
}

// checkedDivide (copied from LD v2.2.1 L197–L203).
pure circuit checkedDivide(
  numeratorF: Field,
  divisorF:   Field,
  r:          DivResult,
): Uint<128> {
  const qF = r.quotient as Field;
  const remF = r.remainder as Field;
  assert(numeratorF == qF * divisorF + remF, "checkedDivide: equation fails");
  const marginF = divisorF - remF - (1 as Field);
  const _range = marginF as Uint<128>;   // runtime-fails if remainder >= divisor
  return r.quotient;
}

// =============================================================================
// WI-13.2 action-log commitment helpers (§SCOPE B, C)
// =============================================================================
//
// CALIBRATION PLACEHOLDER — CAL-13.2-D (action-log Merkle depth `D`).
// ---------------------------------------------------------------------------
// TODO(calibration): CAL-13.2-D is Garrett's call and is DELIBERATELY NOT
// resolved here. The literal `24` used below (in the action_log_path_bits
// witness Vector width, ACTION_LOG_POWERS, the for-loop bounds, and the
// constructor init loop) is a NON-AUTHORITATIVE compilable scaffold ONLY — it
// is NOT the resolved production depth. The dispatch brief §CALIBRATION points
// at the depth-20..24 national-scale band (≈1M–16M lifetime entries) traded
// against the per-emit hash cost. When CAL-13.2-D is resolved, update EVERY
// occurrence of the literal 24 in this file in lockstep (they are enumerated in
// the PR body). The offline harness proves correctness is D-independent; do
// NOT treat 24 as a decision. Caps lifetime action-log entries at 2^D.
pure circuit ACTION_LOG_DEPTH(): Uint<64> { return 24 as Uint<64>; }

// Powers of two 2^0..2^23, for reconstructing `seq` from its LSB-first bits.
// Width MUST equal ACTION_LOG_DEPTH (see CAL-13.2-D note).
pure circuit ACTION_LOG_POWERS(): Vector<24, Field> {
  return [
    1 as Field,        2 as Field,        4 as Field,        8 as Field,
    16 as Field,       32 as Field,       64 as Field,       128 as Field,
    256 as Field,      512 as Field,      1024 as Field,     2048 as Field,
    4096 as Field,     8192 as Field,     16384 as Field,    32768 as Field,
    65536 as Field,    131072 as Field,   262144 as Field,   524288 as Field,
    1048576 as Field,  2097152 as Field,  4194304 as Field,  8388608 as Field,
  ];
}

// fold step: acc + (bit ? pow : 0). Reconstructs an integer from weighted bits.
pure circuit actionLogBitAccum(acc: Field, bit: Boolean, pow: Field): Field {
  return acc + (bit ? pow : (0 as Field));
}

// §SCOPE B — canonical payload hash for a LaneRecord event (kinds 1 & 7).
// N = 14 = tag + kindByte + 12 LaneRecord fields, declaration order.
circuit laneActionPayloadHash(kind: Uint<8>, r: LaneRecord): Bytes<32> {
  return persistentHash<Vector<14, Bytes<32>>>([
    pad(32, "pp:tariff:v1:actionPayload"),
    (disclose(kind) as Field) as Bytes<32>,   // kind byte first-hashed field
    r.scheduleId,
    (r.laneKindByte as Field) as Bytes<32>,
    r.leviedBy,
    (r.bpsShare as Field) as Bytes<32>,
    r.remitAddress,
    (r.basis as Field) as Bytes<32>,
    r.applicabilityHash,
    r.statuteRefHash,
    (r.effectiveEpoch as Field) as Bytes<32>,
    (r.retiredEpoch as Field) as Bytes<32>,
    (r.remittanceMode as Field) as Bytes<32>,
    (r.registeredAt as Field) as Bytes<32>,
  ]);
}

// §SCOPE B — canonical payload hash for a ScheduleRecord event (kinds 0 & 3).
// N = 10 = tag + kindByte + 8 ScheduleRecord fields, declaration order.
circuit scheduleActionPayloadHash(kind: Uint<8>, r: ScheduleRecord): Bytes<32> {
  return persistentHash<Vector<10, Bytes<32>>>([
    pad(32, "pp:tariff:v1:actionPayload"),
    (disclose(kind) as Field) as Bytes<32>,
    r.scheduleId,
    r.nodeId,
    r.scheduleHash,
    r.operatorPubkey,
    (r.effectiveEpoch as Field) as Bytes<32>,
    (r.retiredEpoch as Field) as Bytes<32>,
    (r.refRateFiatPerKwh as Field) as Bytes<32>,
    (r.registeredAt as Field) as Bytes<32>,
  ]);
}

// §SCOPE B — canonical payload hash for a retuneClass event (kind 2).
// N = 12 = tag + kindByte + scheduleId + classPath + 6 SplitShares subfields
//          + rateFiatPerKwh + lastUpdatedAt, declaration order.
circuit retuneActionPayloadHash(
  scheduleId:     Bytes<32>,
  classPath:      Bytes<32>,
  split:          SplitShares,
  rateFiatPerKwh: Uint<64>,
  lastUpdatedAt:  Uint<64>,
): Bytes<32> {
  const s = disclose(split);
  return persistentHash<Vector<12, Bytes<32>>>([
    pad(32, "pp:tariff:v1:actionPayload"),
    (2 as Field) as Bytes<32>,
    disclose(scheduleId),
    disclose(classPath),
    (s.producerShareBps  as Field) as Bytes<32>,
    (s.ldShareBps        as Field) as Bytes<32>,
    (s.opsShareBps       as Field) as Bytes<32>,
    (s.daoShareBps       as Field) as Bytes<32>,
    (s.operatorMarginBps as Field) as Bytes<32>,
    (s.statutoryTotalBps as Field) as Bytes<32>,
    (disclose(rateFiatPerKwh) as Field) as Bytes<32>,
    (disclose(lastUpdatedAt)  as Field) as Bytes<32>,
  ]);
}

// Append `leaf` (= the entry's raw payloadHash) at position `seq` into the
// incremental Merkle tree and recommit registryActionLogRoot. O(D) hashes.
// Pair-hash shape is LOCKED to match assertCharterMembership / WI-14
// reconstructRoot: persistentHash<Vector<3,Bytes<32>>>([nodeTag, left, right]).
circuit appendActionLogLeaf(seq: Uint<64>, leaf: Bytes<32>): [] {
  // Prover-supplied path bits, verified by reconstructing seq (I-13.2-D
  // soundness). Two-sided checked cast = equality assertion with the
  // compiler-generic underflow message (existing bare-assert idiom; no new
  // error label, per §ERROR LABELS).
  const bits = disclose(action_log_path_bits(disclose(seq) as Uint<64>));
  const reconF = fold(actionLogBitAccum, 0 as Field, bits, ACTION_LOG_POWERS());
  const seqF = disclose(seq) as Field;
  const _r1 = (reconF - seqF) as Uint<64>;   // reverts unless reconF >= seqF
  const _r2 = (seqF - reconF) as Uint<64>;   // reverts unless seqF >= reconF
  //  ^ both pass only when reconF == seqF (Field is a large prime).

  const nodeTag = pad(32, "pp:tariff:v1:actionLogNode");
  _actionLogClimb = leaf;
  for (const i of 0..24) {   // ACTION_LOG_DEPTH levels (CAL-13.2-D)
    const bit = bits[i];
    const cur = _actionLogClimb;
    const sib = bit
      ? _actionLogFrontier.lookup(i as Uint<64>)   // right child: sibling is the cached left node
      : _actionLogZeros.lookup(i as Uint<64>);      // left child: sibling is the empty subtree
    if (!bit) {
      _actionLogFrontier.insert(i as Uint<64>, cur);   // cache this left node for future appends
    }
    _actionLogClimb = bit
      ? persistentHash<Vector<3, Bytes<32>>>([nodeTag, sib, cur])
      : persistentHash<Vector<3, Bytes<32>>>([nodeTag, cur, sib]);
  }
  registryActionLogRoot = _actionLogClimb;
}

// Insert a RegistryActionEntry into _actionLog AND append its payloadHash to
// the action-log Merkle tree (WI-13.2). `payloadHash` is computed per-kind by
// the caller (§SCOPE B helpers) or is the pad(32,"") sentinel for non-mirrored
// kinds 4/5/6.
circuit emitAction(
  kind:        Uint<8>,
  scheduleId:  Bytes<32>,
  nodeId:      Bytes<32>,
  actionHash:  Bytes<32>,
  payloadHash: Bytes<32>,
  currentTime: Uint<64>,
): [] {
  const seq = _actionSeq.read();
  const entry = RegistryActionEntry {
    kind:        disclose(kind),
    scheduleId:  disclose(scheduleId),
    nodeId:      disclose(nodeId),
    epoch:       disclose(_currentEpoch.read()),
    actionHash:  disclose(actionHash),
    emittedAt:   disclose(currentTime),
    payloadHash: disclose(payloadHash),
  };
  _actionLog.insert(disclose(seq) as Uint<64>, disclose(entry));
  appendActionLogLeaf(disclose(seq) as Uint<64>, disclose(payloadHash));
  _actionSeq.increment(1);
}

// Assert federation approval + not-replayed + record consumption.
// Shared skeleton for every branch op.
circuit consumeFederationApproval(actionHash: Bytes<32>, opLabel: Bytes<32>): [] {
  const dHash = disclose(actionHash);
  assert(!_consumedFederationApprovals.member(dHash),
         "FEDERATION_APPROVAL_REPLAYED");
  assert(
    disclose(multisig_signature_valid(dHash, _federationAuthority)),
    "FEDERATION_APPROVAL_INVALID"
  );
  _consumedFederationApprovals.insert(dHash);
}

// =============================================================================
// Constructor (LD v2.2.1 pattern; sealed _initialized set once)
// =============================================================================

constructor(
  federationAuthority: Bytes<32>,
  governanceRoot:      Bytes<32>,
  refRateFiatPerKwh:   Uint<64>,
) {
  _federationAuthority = disclose(federationAuthority);
  _governanceRoot      = disclose(governanceRoot);
  _refRateFiatPerKwh   = disclose(refRateFiatPerKwh);

  // CAL-1 / CAL-2 from CALIBRATION-DECISIONS-RESOLVED-2026-07-14.md.
  _LD_FLOOR_BPS    = 200 as Uint<16>;
  _OPS_FLOOR_BPS   = 2000 as Uint<16>;
  _SANITY_BAND_PCT = 20 as Uint<16>;

  _hasPendingContext = false;
  _bootstrapComplete = false;

  // WI-13.3: constructor now seeds only the bootstrap start state. The full
  // WI-13.2 empty-tree loop runs post-deploy via bootstrapActionLog shards.
  _actionLogClimb = pad(32, "pp:tariff:v1:actionLogEmpty");
  _actionLogBootstrapCursor = 0 as Uint<64>;

  // LD v2.2.1 pattern: sealed constructor marker means "constructor ran."
  _initialized = true;
}

// WI-13.3 post-deploy bootstrap: sharded initialization of the WI-13.2
// action-log empty tree to avoid constructor block-limit pressure.
export circuit bootstrapActionLog(shardEnd: Uint<64>): [] {
  assert(!_bootstrapComplete, "TariffRegistry: already initialized");

  const end = disclose(shardEnd);
  const cursor = _actionLogBootstrapCursor;
  assert(end > cursor, "ACTION_LOG_BOOTSTRAP_NON_MONOTONIC");
  assert(end <= 24 as Uint<64>, "ACTION_LOG_BOOTSTRAP_BOUND");

  const nodeTag = pad(32, "pp:tariff:v1:actionLogNode");
  for (const i of 0..24) {   // ACTION_LOG_DEPTH levels (CAL-13.2-D)
    const iU64 = i as Uint<64>;
    if (iU64 >= cursor && iU64 < end) {
      const z = _actionLogClimb;
      _actionLogZeros.insert(iU64, z);
      _actionLogFrontier.insert(iU64, z);
      _actionLogClimb = persistentHash<Vector<3, Bytes<32>>>([nodeTag, z, z]);
    }
  }

  _actionLogBootstrapCursor = end;

  if (end == 24 as Uint<64>) {
    // Preserve WI-13.2 completion semantics: commit depth-D empty root then
    // anchor the forward-only migration boundary at the current action-log head.
    registryActionLogRoot = _actionLogClimb;
    _actionLogBaseSeq = _actionSeq.read();
    _bootstrapComplete = true;
  }
}

// =============================================================================
// Branch op 1: registerSchedule (I-A, I-D, D-4 enforcement)
// =============================================================================

export circuit registerSchedule(
  nodeId:              Bytes<32>,
  scheduleHash:        Bytes<32>,
  operatorPubkey:      Bytes<32>,
  refRateFiatPerKwh:   Uint<64>,
  effectiveEpoch:      Uint<64>,
  validatorAttestor:   Bytes<32>,
  validatorSignature:  Bytes<64>,
  currentTime:         Uint<64>,
): [] {
  assertInitialized();
  assert(disclose(blockTimeGte(disclose(currentTime))),
         "registerSchedule: timestamp cannot be in the future");

  // R-A: charter proof. Witness returns data, not truthiness; circuit
  // reconstructs root against _governanceRoot.
  const proof = charter_membership_proof(nodeId);
  assertCharterMembership(nodeId, proof);

  // I-4: effective epoch must be in the future.
  //   (effectiveEpoch - currentEpoch - 1) as Uint<64>  → reverts if
  //   effectiveEpoch <= currentEpoch. Equivalent to "effectiveEpoch >
  //   currentEpoch".
  const _epochGap = ((disclose(effectiveEpoch)
                      - _currentEpoch.read()
                      - 1) as Uint<64>);

  const currentEpochBytes = (_currentEpoch.read() as Field) as Bytes<32>;
  const effectiveEpochBytes = (disclose(effectiveEpoch) as Field) as Bytes<32>;

  // Federation actionHash: binds every input except the operator pubkey
  // and refRate (those are within the schedule structure; the validator
  // attestor signs off on them via scheduleHash — no double-binding).
  const actionHash = persistentHash<Vector<6, Bytes<32>>>([
    pad(32, "pp:tariff:v1:registerSchedule"),
    selfBytes(),
    disclose(nodeId),
    disclose(scheduleHash),
    effectiveEpochBytes,
    currentEpochBytes,
  ]);

  // WI-16 validator verdict: attestor signs the same actionHash.
  const validatorOk = signature_valid(
    disclose(validatorAttestor),
    actionHash,
    disclose(validatorSignature),
  );
  assert(disclose(validatorOk), "VALIDATOR_VERDICT_INVALID");

  // I-D federation approval + replay guard.
  consumeFederationApproval(
    actionHash,
    pad(32, "pp:tariff:v1:registerSchedule"),
  );

  // Derive scheduleId (deterministic on nodeId + effectiveEpoch + self —
  // same schedule ID cannot exist across two contract deployments).
  const scheduleId = persistentHash<Vector<4, Bytes<32>>>([
    pad(32, "pp:tariff:v1:scheduleId"),
    selfBytes(),
    disclose(nodeId),
    effectiveEpochBytes,
  ]);

  const record = ScheduleRecord {
    scheduleId:      disclose(scheduleId),
    nodeId:          disclose(nodeId),
    scheduleHash:    disclose(scheduleHash),
    operatorPubkey:  disclose(operatorPubkey),
    effectiveEpoch:  disclose(effectiveEpoch),
    retiredEpoch:    0 as Uint<64>,
    refRateFiatPerKwh: disclose(refRateFiatPerKwh),
    registeredAt:    disclose(currentTime),
  };
  _registeredSchedules.insert(disclose(scheduleId), disclose(record));
  _activeScheduleByNode.insert(disclose(nodeId), disclose(scheduleId));

  // WI-13.2: canonical payload over the exact ScheduleRecord just inserted.
  const payloadHash = scheduleActionPayloadHash(0 as Uint<8>, record);
  emitAction(
    0 as Uint<8>,
    scheduleId,
    disclose(nodeId),
    actionHash,
    payloadHash,
    currentTime,
  );
}

// =============================================================================
// Branch op 2: retireSchedule (I-E historical resolvability preserved)
// =============================================================================

export circuit retireSchedule(
  scheduleId:  Bytes<32>,
  currentTime: Uint<64>,
): [] { }

// =============================================================================
// Branch op 3: advanceEpoch (F-7 named-circuit epoch advance)
// =============================================================================

export circuit advanceEpoch(
  newEpoch:            Uint<64>,
  newRefRateFiatPerKwh: Uint<64>,
  newGovernanceRoot:   Bytes<32>,
  currentTime:         Uint<64>,
): [] {
  assertInitialized();
  assert(disclose(blockTimeGte(disclose(currentTime))),
         "advanceEpoch: timestamp cannot be in the future");

  // F-7: newEpoch MUST be currentEpoch + 1 EXACTLY (no skip, no repeat, no
  // decrement). Two-sided checked-cast equality.
  const currentE = _currentEpoch.read();
  const dNew = disclose(newEpoch);
  const _upGap = ((dNew - currentE - 1) as Uint<64>);               // reverts if newEpoch <= currentE
  const _dnGap = ((currentE + 1 - dNew) as Uint<64>);               // reverts if newEpoch > currentE + 1

  const currentEpochBytes = (currentE as Field) as Bytes<32>;
  const newEpochBytes     = (dNew as Field) as Bytes<32>;
  const newRateBytes      = (disclose(newRefRateFiatPerKwh) as Field) as Bytes<32>;

  const actionHash = persistentHash<Vector<6, Bytes<32>>>([
    pad(32, "pp:tariff:v1:advanceEpoch"),
    selfBytes(),
    currentEpochBytes,
    newEpochBytes,
    newRateBytes,
    disclose(newGovernanceRoot),
  ]);

  consumeFederationApproval(
    actionHash,
    pad(32, "pp:tariff:v1:advanceEpoch"),
  );

  _currentEpoch.increment(1);
  _refRateFiatPerKwh = disclose(newRefRateFiatPerKwh);
  _governanceRoot    = disclose(newGovernanceRoot);

  // Swap pending national context atomically iff set. This is the WI-06 §6
  // discipline: floor changes never mid-epoch.
  if (_hasPendingContext) {
    _LD_FLOOR_BPS    = disclose(_pendingLDFloorBps);
    _OPS_FLOOR_BPS   = disclose(_pendingOpsFloorBps);
    _SANITY_BAND_PCT = disclose(_pendingSanityBandPct);
    _hasPendingContext    = false;
    _pendingLDFloorBps    = 0 as Uint<16>;
    _pendingOpsFloorBps   = 0 as Uint<16>;
    _pendingSanityBandPct = 0 as Uint<16>;
  }

  // WI-13.2: kind 4 (advanceEpoch) is NOT mirrored — sentinel payloadHash.
  emitAction(
    4 as Uint<8>,
    pad(32, ""),
    pad(32, ""),
    actionHash,
    pad(32, ""),
    currentTime,
  );
}

// =============================================================================
// Branch op 4: setNationalContext (delayed floor/band change; WI-06 §6)
// =============================================================================

export circuit setNationalContext(
  newLDFloorBps:   Uint<16>,
  newOpsFloorBps:  Uint<16>,
  newSanityBandPct: Uint<16>,
  currentTime:     Uint<64>,
): [] { }

// =============================================================================
// Branch op 5: setFederationAuthority (Tangem ring swap, no redeploy)
// =============================================================================

export circuit setFederationAuthority(
  newAuthorityHash: Bytes<32>,
  currentTime:      Uint<64>,
): [] { }

// =============================================================================
// WI-13.1 Branch op: registerLane (V1.1-DESIGN.md §2.4)
// =============================================================================

export circuit registerLane(
  scheduleId:        Bytes<32>,
  laneKindByte:      Uint<8>,
  leviedBy:          Bytes<32>,
  bpsShare:          Uint<16>,
  remitAddress:      Bytes<32>,
  basis:             Uint<8>,
  applicabilityHash: Bytes<32>,
  statuteRefHash:    Bytes<32>,
  effectiveEpoch:    Uint<64>,
  remittanceMode:    Uint<8>,
  charterProof:      CharterProof,
  currentTime:       Uint<64>,
): [] {
  assertInitialized();
  assert(disclose(blockTimeGte(disclose(currentTime))),
         "registerLane: timestamp cannot be in the future");

  // (a) Schedule must exist and be live.
  const dSchedId = disclose(scheduleId);
  assert(_registeredSchedules.member(dSchedId), "SCHEDULE_NOT_FOUND");
  const schedRec = _registeredSchedules.lookup(dSchedId);
  assert(schedRec.retiredEpoch == 0 as Uint<64>, "SCHEDULE_NOT_LIVE");

  // (a') I-13.1-I / MED-A: leviedBy must be non-zero. The zero-address is
  //      reserved as the resolveLanes empty-slot sentinel, so a lane keyed
  //      on it would be indistinguishable from an unpopulated request slot.
  assert(disclose(leviedBy) != pad(32, ""), "LANE_LEVIED_BY_ZERO");

  // (b) I-13.1-B: Charter proof binds the lane to the SCHEDULE'S nodeId.
  assertCharterMembership(schedRec.nodeId, charterProof);

  // (c) I-13.1-D: effective epoch strictly in the future.
  //     Checked-cast underflow reverts if effectiveEpoch <= currentEpoch.
  const _epochGap = ((disclose(effectiveEpoch)
                      - _currentEpoch.read()
                      - 1) as Uint<64>);
  // Bare checked-cast IS the assertion (V1 §5.4 idiom); reverts with the
  // compiler-generic underflow message. No labeled assert.

  // (c') I-13.1-J: laneKindByte < 16 (reserved statute-kind range).
  //     Checked-cast underflow reverts if laneKindByte >= 16.
  const _kindInRange = ((16 - disclose(laneKindByte) - 1) as Uint<8>);
  // Bare checked-cast IS the assertion; no labeled error.

  // (d) Prepare the 14 hash inputs.
  const kindBytes         = (disclose(laneKindByte) as Field) as Bytes<32>;
  const bpsShareBytes     = (disclose(bpsShare) as Field) as Bytes<32>;
  const basisBytes        = (disclose(basis) as Field) as Bytes<32>;
  const effectiveEpochBytes = (disclose(effectiveEpoch) as Field) as Bytes<32>;
  const remittanceModeBytes = (disclose(remittanceMode) as Field) as Bytes<32>;
  const currentEpochBytes = (_currentEpoch.read() as Field) as Bytes<32>;
  const timeBytes         = (disclose(currentTime) as Field) as Bytes<32>;

  const actionHash = persistentHash<Vector<14, Bytes<32>>>([
    pad(32, "pp:tariff:v1:registerLane"),
    selfBytes(),
    dSchedId,
    kindBytes,
    disclose(leviedBy),
    bpsShareBytes,
    disclose(remitAddress),
    basisBytes,
    disclose(applicabilityHash),
    disclose(statuteRefHash),
    effectiveEpochBytes,
    remittanceModeBytes,
    currentEpochBytes,
    timeBytes,
  ]);

  // (e) I-13.1-A: federation approval + replay guard.
  consumeFederationApproval(
    actionHash,
    pad(32, "pp:tariff:v1:registerLane"),
  );

  // (f) I-13.1-E: duplicate check. Allow re-registration only if the
  //     existing key's record is retired (retiredEpoch != 0).
  //     Key derivation uses the NEW (scheduleId, leviedBy, laneKindByte)
  //     tuple — multi-authority same-kind lanes at different leviedBy
  //     get distinct keys and coexist.
  const key = laneKey(scheduleId, leviedBy, laneKindByte);
  const dKey = disclose(key);
  const keyPresent = _registeredLanes.member(dKey);
  if (keyPresent) {
    assert(
      _registeredLanes.lookup(dKey).retiredEpoch != 0 as Uint<64>,
      "LANE_ALREADY_REGISTERED"
    );
  }

  // (g) Insert the LaneRecord (retiredEpoch = 0 = live).
  const record = LaneRecord {
    scheduleId:        dSchedId,
    laneKindByte:      disclose(laneKindByte),
    leviedBy:          disclose(leviedBy),
    bpsShare:          disclose(bpsShare),
    remitAddress:      disclose(remitAddress),
    basis:             disclose(basis),
    applicabilityHash: disclose(applicabilityHash),
    statuteRefHash:    disclose(statuteRefHash),
    effectiveEpoch:    disclose(effectiveEpoch),
    retiredEpoch:      0 as Uint<64>,
    remittanceMode:    disclose(remittanceMode),
    registeredAt:      disclose(currentTime),
  };
  _registeredLanes.insert(dKey, disclose(record));

  // (h) Emit action kind 1 = LANE_REGISTERED.
  // WI-13.2: canonical payload over all 12 LaneRecord fields just inserted.
  const payloadHash = laneActionPayloadHash(1 as Uint<8>, record);
  emitAction(
    1 as Uint<8>,
    scheduleId,
    schedRec.nodeId,
    actionHash,
    payloadHash,
    currentTime,
  );
}

// =============================================================================
// WI-13.1 Branch op: retireLane (V1.1-DESIGN.md §2.5)
// =============================================================================

export circuit retireLane(
  scheduleId:   Bytes<32>,
  leviedBy:     Bytes<32>,
  laneKindByte: Uint<8>,
  currentTime:  Uint<64>,
): [] { }

// =============================================================================
// Leaf op: retuneClass (F-6 — un-gated by design; safety = in-circuit floor
//                       + sanity-band re-check per F-5)
// =============================================================================

export circuit retuneClass(
  scheduleId:            Bytes<32>,
  classPath:             Bytes<32>,
  newSplitBps:           SplitShares,
  newRateFiatPerKwh:     Uint<64>,      // WI-06 §5.5: rate is a leaf-op knob
  operatorId:            Bytes<32>,
  operatorSignature:     Bytes<64>,
  nonceIn:               Uint<64>,
  currentTime:           Uint<64>,
  divLo:                 DivResult,     // witness-divmod for low band edge
  divHi:                 DivResult,     // witness-divmod for high band edge
): [] { }

// =============================================================================
// Read-only views (I-F — no state mutation, no value primitives)
// =============================================================================

// R-C resolution: strict bounds on epoch, no arbitrary-epoch oracle.
export circuit resolvePath(
  scheduleId: Bytes<32>,
  classPath:  Bytes<32>,
  epoch:      Uint<64>,
): ClassEntry { return ClassEntry {
    bps: SplitShares {
      producerShareBps:  0 as Uint<16>,
      ldShareBps:        0 as Uint<16>,
      opsShareBps:       0 as Uint<16>,
      daoShareBps:       0 as Uint<16>,
      operatorMarginBps: 0 as Uint<16>,
      statutoryTotalBps: 0 as Uint<16>,
    },
    rateFiatPerKwh: 0 as Uint<64>,
    lastUpdatedAt:  0 as Uint<64>,
  }; }

// Settlement fast-path — hardcodes current epoch, cannot be tricked into
// returning a stale-epoch split. WI-14 uses this.
export circuit resolveCurrent(
  scheduleId: Bytes<32>,
  classPath:  Bytes<32>,
): ClassEntry { return ClassEntry {
    bps: SplitShares {
      producerShareBps:  0 as Uint<16>,
      ldShareBps:        0 as Uint<16>,
      opsShareBps:       0 as Uint<16>,
      daoShareBps:       0 as Uint<16>,
      operatorMarginBps: 0 as Uint<16>,
      statutoryTotalBps: 0 as Uint<16>,
    },
    rateFiatPerKwh: 0 as Uint<64>,
    lastUpdatedAt:  0 as Uint<64>,
  }; }

// Charter membership check (used by WI-16 tooling + WI-14 pre-flight).
export circuit isChartered(nodeId: Bytes<32>, proof: CharterProof): Boolean {
  assertInitialized();
  // Reconstruct the root and compare (non-reverting version of
  // assertCharterMembership).
  const dSiblings = disclose(proof.siblings);
  const dIndices  = disclose(proof.indices);

  const leaf = persistentHash<Vector<2, Bytes<32>>>([
    pad(32, "pp:fed:charter:leaf"),
    disclose(nodeId),
  ]);
  const pairDomain = pad(32, "pp:fed:charter:node");

  const h0 = leaf;
  const h1 = dIndices[0]
    ? persistentHash<Vector<3, Bytes<32>>>([pairDomain, dSiblings[0], h0])
    : persistentHash<Vector<3, Bytes<32>>>([pairDomain, h0, dSiblings[0]]);
  const h2 = dIndices[1]
    ? persistentHash<Vector<3, Bytes<32>>>([pairDomain, dSiblings[1], h1])
    : persistentHash<Vector<3, Bytes<32>>>([pairDomain, h1, dSiblings[1]]);
  const h3 = dIndices[2]
    ? persistentHash<Vector<3, Bytes<32>>>([pairDomain, dSiblings[2], h2])
    : persistentHash<Vector<3, Bytes<32>>>([pairDomain, h2, dSiblings[2]]);
  const h4 = dIndices[3]
    ? persistentHash<Vector<3, Bytes<32>>>([pairDomain, dSiblings[3], h3])
    : persistentHash<Vector<3, Bytes<32>>>([pairDomain, h3, dSiblings[3]]);
  const h5 = dIndices[4]
    ? persistentHash<Vector<3, Bytes<32>>>([pairDomain, dSiblings[4], h4])
    : persistentHash<Vector<3, Bytes<32>>>([pairDomain, h4, dSiblings[4]]);
  const h6 = dIndices[5]
    ? persistentHash<Vector<3, Bytes<32>>>([pairDomain, dSiblings[5], h5])
    : persistentHash<Vector<3, Bytes<32>>>([pairDomain, h5, dSiblings[5]]);
  const h7 = dIndices[6]
    ? persistentHash<Vector<3, Bytes<32>>>([pairDomain, dSiblings[6], h6])
    : persistentHash<Vector<3, Bytes<32>>>([pairDomain, h6, dSiblings[6]]);
  const h8 = dIndices[7]
    ? persistentHash<Vector<3, Bytes<32>>>([pairDomain, dSiblings[7], h7])
    : persistentHash<Vector<3, Bytes<32>>>([pairDomain, h7, dSiblings[7]]);
  const h9 = dIndices[8]
    ? persistentHash<Vector<3, Bytes<32>>>([pairDomain, dSiblings[8], h8])
    : persistentHash<Vector<3, Bytes<32>>>([pairDomain, h8, dSiblings[8]]);
  const h10 = dIndices[9]
    ? persistentHash<Vector<3, Bytes<32>>>([pairDomain, dSiblings[9], h9])
    : persistentHash<Vector<3, Bytes<32>>>([pairDomain, h9, dSiblings[9]]);
  const h11 = dIndices[10]
    ? persistentHash<Vector<3, Bytes<32>>>([pairDomain, dSiblings[10], h10])
    : persistentHash<Vector<3, Bytes<32>>>([pairDomain, h10, dSiblings[10]]);
  const root = dIndices[11]
    ? persistentHash<Vector<3, Bytes<32>>>([pairDomain, dSiblings[11], h11])
    : persistentHash<Vector<3, Bytes<32>>>([pairDomain, h11, dSiblings[11]]);

  return root == _governanceRoot;
}

// Whether a schedule is currently live (registered, not retired, at or
// past effectiveEpoch).
export circuit isScheduleActive(scheduleId: Bytes<32>): Boolean { return false; }

// =============================================================================
// WI-13.2 action-log read circuits (§SCOPE D — pure reads, I-F preserved)
// =============================================================================

// Full authoritative event body at `seq` (incl. payloadHash). Keepers fetch
// this to reconstruct-and-verify the mirror against registryActionLogRoot.
export circuit getActionEntry(seq: Uint<64>): RegistryActionEntry {
  assertInitialized();
  assert(_actionLog.member(disclose(seq)), "ACTION_LOG_SEQ_MISSING");
  return _actionLog.lookup(disclose(seq));
}

// Cheap targeted read: just the canonical payloadHash at `seq`.
export circuit getActionPayloadHash(seq: Uint<64>): Bytes<32> {
  assertInitialized();
  assert(_actionLog.member(disclose(seq)), "ACTION_LOG_SEQ_MISSING");
  return _actionLog.lookup(disclose(seq)).payloadHash;
}

// =============================================================================
// WI-13.1 Read-only views (V1.1-DESIGN.md §2.6, §2.7, §2.8)
// =============================================================================

// resolveLane — read-only view for a single lane record.
export circuit resolveLane(
  scheduleId:   Bytes<32>,
  leviedBy:     Bytes<32>,
  laneKindByte: Uint<8>,
): LaneRecord { return LaneRecord {
    scheduleId:        pad(32, ""),
    laneKindByte:      0 as Uint<8>,
    leviedBy:          pad(32, ""),
    bpsShare:          0 as Uint<16>,
    remitAddress:      pad(32, ""),
    basis:             0 as Uint<8>,
    applicabilityHash: pad(32, ""),
    statuteRefHash:    pad(32, ""),
    effectiveEpoch:    0 as Uint<64>,
    retiredEpoch:      0 as Uint<64>,
    remittanceMode:    0 as Uint<8>,
    registeredAt:      0 as Uint<64>,
  }; }

// resolveLanes — bounded batch view for multiple lanes.
// Width 4 = the Kenya statutory stack (VAT + REP + EPRA + WARMA) per
// V1.1-DESIGN.md §2.0. No per-schedule lane cap; the width is a WI-14
// settle-circuit capacity constraint, not a registry cap.
export circuit resolveLanes(
  scheduleId:    Bytes<32>,
  leviedBys:     Vector<4, Bytes<32>>,
  laneKindBytes: Vector<4, Uint<8>>,
): Vector<4, LaneRecord> { const zero = LaneRecord {
    scheduleId:        pad(32, ""),
    laneKindByte:      0 as Uint<8>,
    leviedBy:          pad(32, ""),
    bpsShare:          0 as Uint<16>,
    remitAddress:      pad(32, ""),
    basis:             0 as Uint<8>,
    applicabilityHash: pad(32, ""),
    statuteRefHash:    pad(32, ""),
    effectiveEpoch:    0 as Uint<64>,
    retiredEpoch:      0 as Uint<64>,
    remittanceMode:    0 as Uint<8>,
    registeredAt:      0 as Uint<64>,
  };
  return [zero, zero, zero, zero]; }

// isLaneActive — read-only Boolean check for lane activity.
// A lane is active iff its record exists, is not retired, is in-effect at the
// current epoch, AND its parent schedule exists and is itself live (MED-B:
// a lane under a retired schedule is not active even if the lane record's own
// retiredEpoch is still 0 — retireSchedule does not touch lane records).
export circuit isLaneActive(
  scheduleId:   Bytes<32>,
  leviedBy:     Bytes<32>,
  laneKindByte: Uint<8>,
): Boolean { return false; }
