//   //   assert lowEdge <= newRate <= highEdge  (two checked casts)
//   //
//   // bandBps = SANITY_BAND_PCT * 100  (e.g. 20% → 2000 bps).
//   // All intermediate math in Field to avoid Uint<128> overflow warnings;
//   // final band-edge assertions in Uint<128> via checked casts.
//   const bandBpsF = (_SANITY_BAND_PCT as Field) * (100 as Field);
//   const refRateF = rec.refRateFiatPerKwh as Field;
//   const bandDelta = checkedDivide(
//     refRateF * bandBpsF,
//     10000 as Field,
//     disclose(divLo),
//   );
//   // divHi is threaded through for future asymmetric bands + to lock the ABI
//   // shape; today the band is symmetric so bandDelta serves both edges.
//   const _dummyHi = checkedDivide(
//     refRateF * bandBpsF,
//     10000 as Field,
//     disclose(divHi),
//   );
//   const bandDeltaF = bandDelta as Field;
//   const newRateF = disclose(newRateFiatPerKwh) as Field;
//   // lowEdge  = refRate - bandDelta  (must not underflow refRate as Field)
//   // highEdge = refRate + bandDelta
//   //   assert lowEdge <= newRate  ≡ (newRate - lowEdge) as Uint<128>
//   //   assert newRate <= highEdge ≡ (highEdge - newRate) as Uint<128>
//   // Combining:
//   //   loGap = newRate - (refRate - bandDelta) = newRate + bandDelta - refRate
//   //   hiGap = (refRate + bandDelta) - newRate
//   const _bandLo = ((newRateF + bandDeltaF - refRateF) as Uint<128>);
//   const _bandHi = ((refRateF + bandDeltaF - newRateF) as Uint<128>);
//
//   // Commit the new class entry (bps + rate + timestamp).
//   const splitKey = classSplitKey(scheduleId, classPath);
//   const classEntry = ClassEntry {
//     bps:            disclose(newSplitBps),
//     rateFiatPerKwh: disclose(newRateFiatPerKwh),
//     lastUpdatedAt:  disclose(currentTime),
//   };
//   _classEntries.insert(disclose(splitKey), disclose(classEntry));
//   const classEntryHash = persistentHash<Vector<9, Bytes<32>>>([
//     pad(32, "pp:tariff:v1:classEntry"),
//     (classEntry.bps.producerShareBps as Field) as Bytes<32>,
//     (classEntry.bps.ldShareBps as Field) as Bytes<32>,
//     (classEntry.bps.opsShareBps as Field) as Bytes<32>,
//     (classEntry.bps.daoShareBps as Field) as Bytes<32>,
//     (classEntry.bps.operatorMarginBps as Field) as Bytes<32>,
//     (classEntry.bps.statutoryTotalBps as Field) as Bytes<32>,
//     (classEntry.rateFiatPerKwh as Field) as Bytes<32>,
//     (classEntry.lastUpdatedAt as Field) as Bytes<32>,
//   ]);
//   // V2-SPLIT-DESIGN.md §4.7 maps class-entry root updates to `retuneClass`.
//   // chose (A) append-only per §4.6-implementation-note; sparse-tree deferred.
//   const classEntryLeaf = persistentHash<Vector<3, Bytes<32>>>([
//     pad(32, "pp:tariff:v1:classEntriesLeaf"),
//     disclose(splitKey),
//     classEntryHash,
//   ]);
//   const classEntrySeq = _classEntriesMerkleSeq.read();
//   appendClassEntryLeaf(disclose(classEntrySeq) as Uint<64>, disclose(classEntryLeaf));
//   _classEntriesMerkleSeq.increment(1);
//
//   // Advance nonce and cooldown.
//   _retuneNonces.insert(disclose(nonceKey), disclose(nonceIn));
//   _retuneLastTime.insert(disclose(cdKey), disclose(currentTime));
//
//   // WI-13.2: canonical payload over (scheduleId, classPath, the 6 SplitShares
//   // subfields, rateFiatPerKwh, lastUpdatedAt = currentTime). Distinct from the
//   // authorization hash (retuneAuthHash → actionHash slot).
//   const payloadHash = retuneActionPayloadHash(
//     scheduleId, classPath, newSplitBps, newRateFiatPerKwh, currentTime);
//   emitAction(
//     2 as Uint<8>,
//     dSid,
//     rec.nodeId,
//     retuneAuthHash,
//     payloadHash,
//     currentTime,
//   );
// }
// END DEFERRED-TO-V1.1
export circuit resolveLane(
  scheduleId:   Bytes<32>,
  leviedBy:     Bytes<32>,
  laneKindByte: Uint<8>,
): LaneRecord {
  assertInitialized();
  const key = laneKey(scheduleId, leviedBy, laneKindByte);
  assert(_registeredLanes.member(disclose(key)), "LANE_NOT_FOUND");
  return _registeredLanes.lookup(disclose(key));
}
export circuit resolveLanes(
  scheduleId:    Bytes<32>,
  leviedBys:     Vector<4, Bytes<32>>,
  laneKindBytes: Vector<4, Uint<8>>,
): Vector<4, LaneRecord> {
  assertInitialized();
  const dLeviedBys = disclose(leviedBys);
  const dKinds     = disclose(laneKindBytes);
  const zero = LaneRecord {
    scheduleId:        pad(32, ""),
    laneKindByte:      0 as Uint<8>,
    leviedBy:          pad(32, ""),
    bpsShare:          0 as Uint<16>,
    remitAddress:      pad(32, ""),
    basis:             0 as Uint<8>,
    applicabilityHash: pad(32, ""),
    statuteRefHash:    pad(32, ""),
    effectiveEpoch:    0 as Uint<64>,
    retiredEpoch:      0 as Uint<64>,
    remittanceMode:    0 as Uint<8>,
    registeredAt:      0 as Uint<64>,
  };
  const k0 = laneKey(scheduleId, dLeviedBys[0], dKinds[0]);
  const r0 = _registeredLanes.member(disclose(k0))
    ? _registeredLanes.lookup(disclose(k0)) : zero;
  const k1 = laneKey(scheduleId, dLeviedBys[1], dKinds[1]);
  const r1 = _registeredLanes.member(disclose(k1))
    ? _registeredLanes.lookup(disclose(k1)) : zero;
  const k2 = laneKey(scheduleId, dLeviedBys[2], dKinds[2]);
  const r2 = _registeredLanes.member(disclose(k2))
    ? _registeredLanes.lookup(disclose(k2)) : zero;
  const k3 = laneKey(scheduleId, dLeviedBys[3], dKinds[3]);
  const r3 = _registeredLanes.member(disclose(k3))
    ? _registeredLanes.lookup(disclose(k3)) : zero;
  return [r0, r1, r2, r3];
}
export circuit isLaneActive(
  scheduleId:   Bytes<32>,
  leviedBy:     Bytes<32>,
  laneKindByte: Uint<8>,
): Boolean {
  assertInitialized();
  const key = laneKey(scheduleId, leviedBy, laneKindByte);
  if (!_registeredLanes.member(disclose(key))) {
    return false;
  }
  const rec = _registeredLanes.lookup(disclose(key));
  if (rec.retiredEpoch != 0 as Uint<64>) {
    return false;
  }
  // MED-B: parent schedule must exist and be live.
  const dSid = disclose(scheduleId);
  if (!_registeredSchedules.member(dSid)) {
    return false;
  }
  if (_registeredSchedules.lookup(dSid).retiredEpoch != 0 as Uint<64>) {
    return false;
  }
  return _currentEpoch.read() >= rec.effectiveEpoch;
}

// =============================================================================
// WI-15.1 mirror-write endpoints (V2-SPLIT-DESIGN.md §4.1, §4.2, §4.3, §4.6, §4.9)
// =============================================================================
//
// Body pattern from V2-SPLIT-DESIGN.md §4.1 (verbatim block quote):
//
//   1. `assert(signature_valid(govAuthorityHash, newRoot || epochAtMirror, govAuthoritySig))` — same witness function as `tariff-registry-v1.compact:116-124`.
//   2. `assert(epochAtMirror > _mirroredEpoch, "MIRROR_EPOCH_STALE")` — monotone.
//   3. Write `_mirroredGovernanceRoot = disclose(newRoot)`, `_mirroredEpoch = disclose(epochAtMirror)`.
//   4. Emit `MIRROR_GOV_ROOT` action to local outbox with `payloadHash = persistentHash([tag, newRoot, epochAtMirror])`.
//
// I-15-B (verbatim from V2-SPLIT-DESIGN.md §8.4):
//
//   Every mirror-write circuit MUST verify a signature under the source contract's federation authority (or a designated mirror-writer authority) over the tuple `(newRootValue, sourceEpochAtMirror)`, AND MUST enforce monotone `sourceEpochAtMirror` progression against a locally stored `_lastMirroredEpoch`.

export ledger _mirroredGovernanceRoot:          Bytes<32>;
export ledger _mirroredEpoch:                   Uint<64>;
export ledger _mirroredLDFloorBps:              Uint<16>;
export ledger _mirroredOpsFloorBps:             Uint<16>;
export ledger _mirroredSanityBandPct:           Uint<16>;
export ledger _mirroredRefRateFiatPerKwh:       Uint<64>;
export ledger _mirroredFederationAuthority:     Bytes<32>;
export ledger _mirroredSchedulesRoot:           Bytes<32>;
export ledger _mirroredSchedulesEpoch:          Uint<64>;
export ledger _mirroredAuditRoot:               Bytes<32>;
export ledger _mirroredAuditGlobalSeq:          Uint<64>;

// -----------------------------------------------------------------------------
// mirrorGovernanceRoot — Lane (§4.1)
// -----------------------------------------------------------------------------
export circuit mirrorGovernanceRoot(
  newRoot:         Bytes<32>,
  epochAtMirror:   Uint<64>,
  govAuthoritySig: Bytes<64>,
  govAuthorityHash: Bytes<32>,
  currentTime:     Uint<64>,
): [] {
  assertInitialized();
  assert(disclose(blockTimeGte(disclose(currentTime))),
         "mirrorGovernanceRoot: timestamp cannot be in the future");

  const dRoot  = disclose(newRoot);
  const dEpoch = disclose(epochAtMirror);
  const dAuth  = disclose(govAuthorityHash);
  const epochBytes = (dEpoch as Field) as Bytes<32>;

  const msg = persistentHash<Vector<5, Bytes<32>>>([
    pad(32, "pp:tariff:v2:mirrorGovRoot"),
    selfBytes(),
    dRoot,
    epochBytes,
    dAuth,
  ]);

  // WI-15.1 Fix A: sealed genesis trust anchor — no bootstrap short-circuit.
  const cur = _mirroredFederationAuthority;
  assert(disclose(dAuth == cur), "MIRROR_GOV_AUTH_MISMATCH");
  assert(disclose(signature_valid(dAuth, msg, disclose(govAuthoritySig))),
         "MIRROR_GOV_ROOT_SIG_INVALID");

  const upGap = ((dEpoch - _mirroredEpoch - 1) as Uint<64>);

  _mirroredGovernanceRoot = dRoot;
  _mirroredEpoch = dEpoch;

  const payloadHash = persistentHash<Vector<3, Bytes<32>>>([
    pad(32, "pp:tariff:v2:mirrorGovRoot"),
    dRoot,
    epochBytes,
  ]);
  emitAction(
    16 as Uint<8>,
    pad(32, ""),
    pad(32, ""),
    msg,
    payloadHash,
    currentTime,
  );
}

// -----------------------------------------------------------------------------
// mirrorEpochAndFloors — Lane (§4.2)
// -----------------------------------------------------------------------------
export circuit mirrorEpochAndFloors(
  newEpoch:         Uint<64>,
  newLDFloorBps:    Uint<16>,
  newOpsFloorBps:   Uint<16>,
  newSanityBandPct: Uint<16>,
  newRefRateFiatPerKwh: Uint<64>,
  govAuthoritySig:  Bytes<64>,
  govAuthorityHash: Bytes<32>,
  currentTime:      Uint<64>,
): [] {
  assertInitialized();
  assert(disclose(blockTimeGte(disclose(currentTime))),
         "mirrorEpochAndFloors: timestamp cannot be in the future");

  const dEpoch = disclose(newEpoch);
  const dLD    = disclose(newLDFloorBps);
  const dOps   = disclose(newOpsFloorBps);
  const dBand  = disclose(newSanityBandPct);
  const dRate  = disclose(newRefRateFiatPerKwh);
  const dAuth  = disclose(govAuthorityHash);

  const epochBytes = (dEpoch as Field) as Bytes<32>;
  const ldBytes    = (dLD    as Field) as Bytes<32>;
  const opsBytes   = (dOps   as Field) as Bytes<32>;
  const bandBytes  = (dBand  as Field) as Bytes<32>;
  const rateBytes  = (dRate  as Field) as Bytes<32>;

  const msg = persistentHash<Vector<8, Bytes<32>>>([
    pad(32, "pp:tariff:v2:mirrorEpochFloors"),
    selfBytes(),
    epochBytes,
    ldBytes,
    opsBytes,
    bandBytes,
    rateBytes,
    dAuth,
  ]);

  // WI-15.1 Fix A: sealed genesis trust anchor — no bootstrap short-circuit.
  const cur = _mirroredFederationAuthority;
  assert(disclose(dAuth == cur), "MIRROR_GOV_AUTH_MISMATCH");
  assert(disclose(signature_valid(dAuth, msg, disclose(govAuthoritySig))),
         "MIRROR_EPOCH_FLOORS_SIG_INVALID");

  const upGap = ((dEpoch - _mirroredEpoch - 1) as Uint<64>);

  _mirroredEpoch = dEpoch;
  _mirroredLDFloorBps = dLD;
  _mirroredOpsFloorBps = dOps;
  _mirroredSanityBandPct = dBand;
  _mirroredRefRateFiatPerKwh = dRate;

  const payloadHash = persistentHash<Vector<6, Bytes<32>>>([
    pad(32, "pp:tariff:v2:mirrorEpochFloors"),
    epochBytes,
    ldBytes,
    opsBytes,
    bandBytes,
    rateBytes,
  ]);
  emitAction(
    17 as Uint<8>,
    pad(32, ""),
    pad(32, ""),
    msg,
    payloadHash,
    currentTime,
  );
}

// -----------------------------------------------------------------------------
// mirrorFederationAuthority — Lane (§4.3)
// -----------------------------------------------------------------------------
export circuit mirrorFederationAuthority(
  newAuth:         Bytes<32>,
  epochAtMirror:   Uint<64>,
  currentAuthSig:  Bytes<64>,
  currentAuthHash: Bytes<32>,
  currentTime:     Uint<64>,
): [] {
  assertInitialized();
  assert(disclose(blockTimeGte(disclose(currentTime))),
         "mirrorFederationAuthority: timestamp cannot be in the future");

  const dNew   = disclose(newAuth);
  const dEpoch = disclose(epochAtMirror);
  const dCur   = disclose(currentAuthHash);
  const epochBytes = (dEpoch as Field) as Bytes<32>;

  assert(dNew != pad(32, ""), "MIRROR_FED_AUTH_ZERO");

  const msg = persistentHash<Vector<5, Bytes<32>>>([
    pad(32, "pp:tariff:v2:mirrorFedAuth"),
    selfBytes(),
    dNew,
    epochBytes,
    dCur,
  ]);

  // WI-15.1 Fix A: sealed genesis trust anchor — no bootstrap short-circuit.
  const cur = _mirroredFederationAuthority;
  assert(disclose(dCur == cur), "MIRROR_FED_AUTH_MISMATCH");
  assert(disclose(signature_valid(dCur, msg, disclose(currentAuthSig))),
         "MIRROR_FED_AUTH_SIG_INVALID");

  const upGap = ((dEpoch - _mirroredEpoch - 1) as Uint<64>);

  _mirroredFederationAuthority = dNew;
  _mirroredEpoch = dEpoch;

  const payloadHash = persistentHash<Vector<3, Bytes<32>>>([
    pad(32, "pp:tariff:v2:mirrorFedAuth"),
    dNew,
    epochBytes,
  ]);
  emitAction(
    18 as Uint<8>,
    pad(32, ""),
    pad(32, ""),
    msg,
    payloadHash,
    currentTime,
  );
}

// -----------------------------------------------------------------------------
// mirrorSchedulesRoot — Lane (§4.6)
// -----------------------------------------------------------------------------
// Per §4.6: Lane needs `_registeredSchedules.member(scheduleId)` and
// `retiredEpoch == 0` (I-13.1-C) via witness Merkle proof against
// `_mirroredSchedulesRoot`. Signer is the federation authority per the
// mirror-write pattern table (§4 opening rows).
export circuit mirrorSchedulesRoot(
  newRoot:         Bytes<32>,
  schedulesEpoch:  Uint<64>,
  govAuthoritySig: Bytes<64>,
  govAuthorityHash: Bytes<32>,
  currentTime:     Uint<64>,
): [] {
  assertInitialized();
  assert(disclose(blockTimeGte(disclose(currentTime))),
         "mirrorSchedulesRoot: timestamp cannot be in the future");

  const dRoot  = disclose(newRoot);
  const dEpoch = disclose(schedulesEpoch);
  const dAuth  = disclose(govAuthorityHash);
  const epochBytes = (dEpoch as Field) as Bytes<32>;

  const msg = persistentHash<Vector<5, Bytes<32>>>([
    pad(32, "pp:tariff:v2:mirrorSchedulesRoot"),
    selfBytes(),
    dRoot,
    epochBytes,
    dAuth,
  ]);

  // WI-15.1 Fix A: sealed genesis trust anchor — no bootstrap short-circuit.
  const cur = _mirroredFederationAuthority;
  assert(disclose(dAuth == cur), "MIRROR_GOV_AUTH_MISMATCH");
  assert(disclose(signature_valid(dAuth, msg, disclose(govAuthoritySig))),
         "MIRROR_SCHEDULES_ROOT_SIG_INVALID");

  // I-15-B monotone against `_mirroredSchedulesEpoch` (per §4.6: Lane
  // holds `_mirroredSchedulesEpoch` as the local sibling epoch).
  const upGap = ((dEpoch - _mirroredSchedulesEpoch - 1) as Uint<64>);

  _mirroredSchedulesRoot = dRoot;
  _mirroredSchedulesEpoch = dEpoch;

  const payloadHash = persistentHash<Vector<3, Bytes<32>>>([
    pad(32, "pp:tariff:v2:mirrorSchedulesRoot"),
    dRoot,
    epochBytes,
  ]);
  emitAction(
    19 as Uint<8>,
    pad(32, ""),
    pad(32, ""),
    msg,
    payloadHash,
    currentTime,
  );
}

// -----------------------------------------------------------------------------
// mirrorAuditRoot — Lane (§4.9)
// -----------------------------------------------------------------------------
export circuit mirrorAuditRoot(
  newRoot:              Bytes<32>,
  globalSeqAtMirror:    Uint<64>,
  writerSig:            Bytes<64>,
  writerAuthHash:       Bytes<32>,
  currentTime:          Uint<64>,
): [] {
  assertInitialized();
  assert(disclose(blockTimeGte(disclose(currentTime))),
         "mirrorAuditRoot: timestamp cannot be in the future");

  const dRoot  = disclose(newRoot);
  const dSeq   = disclose(globalSeqAtMirror);
  const dAuth  = disclose(writerAuthHash);
  const seqBytes = (dSeq as Field) as Bytes<32>;

  const msg = persistentHash<Vector<5, Bytes<32>>>([
    pad(32, "pp:tariff:v2:mirrorAuditRoot"),
    selfBytes(),
    dRoot,
    seqBytes,
    dAuth,
  ]);

  // WI-15.1 Fix A: `_auditWriterAuthorityTarget` sealed at genesis by Lane's
  // constructor from `initialAuditWriterAuthority`. No bootstrap short-circuit.
  const target = _auditWriterAuthorityTarget;
  assert(disclose(dAuth == target), "MIRROR_AUDIT_AUTH_MISMATCH");
  assert(disclose(signature_valid(dAuth, msg, disclose(writerSig))),
         "MIRROR_AUDIT_ROOT_SIG_INVALID");

  const upGap = ((dSeq - _mirroredAuditGlobalSeq - 1) as Uint<64>);

  _mirroredAuditRoot = dRoot;
  _mirroredAuditGlobalSeq = dSeq;

  const payloadHash = persistentHash<Vector<3, Bytes<32>>>([
    pad(32, "pp:tariff:v2:mirrorAuditRoot"),
    dRoot,
    seqBytes,
  ]);
  emitAction(
    22 as Uint<8>,
    pad(32, ""),
    pad(32, ""),
    msg,
    payloadHash,
    currentTime,
  );
}
