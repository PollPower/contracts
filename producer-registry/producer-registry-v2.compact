// SPDX-License-Identifier: Apache-2.0
//
// PollPower ProducerRegistry v2 — Ed25519-witness governed meter registry
//
// =============================================================================
// OFF-CHAIN SIGNER CONTRACT — actionHash byte layouts (Phase 2 / registry binding)
// =============================================================================
// Admins sign the actionHash directly in approve(). Off-chain MUST compute the
// SAME persistentHash as the matching execute* circuit helper.
// Field order: [opSel, selfBytes, param, nextNonce] — each Bytes<32>.
//
// | Circuit / helper       | opSel pad (→ persistentHash)   | Vector<N> | Field order                              | approve↔execute match |
// |------------------------|--------------------------------|-----------|------------------------------------------|------------------------|
// | addAdminActionHash     | "registry:v2:addAdmin"         | 4         | opSel, self, newAdmin, nextNonce         | executeAddAdmin calls same helper |
// | removeAdminActionHash  | "registry:v2:removeAdmin"      | 4         | opSel, self, removedAdmin, nextNonce     | executeRemoveAdmin calls same helper |
// | setThresholdActionHash | "registry:v2:setThreshold"     | 4         | opSel, self, newThreshold, nextNonce     | executeSetThreshold calls same helper |
// | addMeterActionHash     | "registry:v2:addMeter"         | 4         | opSel, self, meterKeyHash, nextNonce     | executeAddMeter calls same helper |
// | removeMeterActionHash  | "registry:v2:removeMeter"      | 4         | opSel, self, meterKeyHash, nextNonce     | executeRemoveMeter calls same helper |
//
// selfBytes = disclose(kernel.self()).bytes (this registry deployment address).
// nextNonce = (_nonce.read() + 1) as Field as Bytes<32>.
// opSel = persistentHash<Bytes<32>>(pad(32, "<op label>")).
//
// STRUCTURE: shared helper circuits (same invariant as multisig v7). approve()
// receives the full actionHash from off-chain signers; each execute* recomputes
// via the SAME helper — layouts identical by construction.
//
// =============================================================================
// WHAT CHANGES FROM V1 (Phase 2 — contract-address binding)
// =============================================================================
//
// v1 actionHash bound op+params+nonce but NOT registry contract address →
// cross-deployment replay. Planned v1.1 contractTag wrap was never deployed.
// v2 SUPERSEDES contractTag: selfBytes folded INTO actionHash.
//
// Replaced: Vector<3> [opSel, param, nextNonce] → Vector<4> with selfBytes.
// Op labels bumped: registry:<op> → registry:v2:<op> (version-scoped separators).
//
// Carried from v1: slim Set<Bytes<32>> meter registry, Ed25519 witness gate,
// 3-of-5 admin governance, seed meter at initialize().
//
// Toolchain: compactc 0.30.0, language 0.22.0.
// Base: producer-registry-v1.compact (contracts/dev/producer-registry-v1/).
//
// Branch: dev/producer-registry-v2
// Date:   2026-07-04
// VERIFY: compile-check pending (Joi)
// =============================================================================

pragma language_version >= 0.16 && <= 0.22;

import CompactStandardLibrary;

// =============================================================================
// Witness: Ed25519 signature verification (same as v1 / multisig)
// =============================================================================
witness signature_valid(
  pubkey: Bytes<32>,
  messageHash: Bytes<32>,
  signature: Bytes<64>,
): Boolean;

// =============================================================================
// Ledger state
// =============================================================================

export ledger _admins: Set<Bytes<32>>;
export ledger _threshold: Uint<8>;
export ledger _nonce: Counter;
export ledger _approvals: Map<Bytes<32>, Set<Bytes<32>>>;

export ledger _meters: Set<Bytes<32>>;

export ledger _initialized: Boolean;

// =============================================================================
// Initialization
// =============================================================================

export circuit initialize(
  admin1: Bytes<32>,
  admin2: Bytes<32>,
  admin3: Bytes<32>,
  admin4: Bytes<32>,
  admin5: Bytes<32>,
  threshold: Uint<8>,
  seedMeterKeyHash: Bytes<32>,
  seedEnabled: Boolean,
): [] {
  assert(!_initialized, "Already initialized");
  assert(threshold > 0 as Uint<8>, "Threshold must be > 0");
  assert(threshold <= 5 as Uint<8>, "Threshold must be <= initial admin count");

  _admins.insert(disclose(admin1));
  _admins.insert(disclose(admin2));
  _admins.insert(disclose(admin3));
  _admins.insert(disclose(admin4));
  _admins.insert(disclose(admin5));

  _threshold = disclose(threshold);
  _initialized = disclose(true);

  if (disclose(seedEnabled)) {
    _meters.insert(disclose(seedMeterKeyHash));
  }
}

// =============================================================================
// Approve circuit — Ed25519 sig required
// =============================================================================
export circuit approve(
  actionHash: Bytes<32>,
  signerPubkey: Bytes<32>,
  signature: Bytes<64>,
): [] {
  assert(_initialized, "Not initialized");

  const sigOk = signature_valid(signerPubkey, actionHash, signature);
  assert(disclose(sigOk), "Bad Ed25519 signature");

  assert(_admins.member(disclose(signerPubkey)), "Signer is not an admin");

  const dHash = disclose(actionHash);
  if (!_approvals.member(dHash)) {
    _approvals.insertDefault(dHash);
  }
  _approvals.lookup(dHash).insert(disclose(signerPubkey));
}

// =============================================================================
// Read circuits
// =============================================================================

export circuit isAdmin(account: Bytes<32>): Boolean {
  return _admins.member(disclose(account));
}

export circuit getThreshold(): Uint<8> {
  return _threshold;
}

export circuit getAdminCount(): Uint<64> {
  return _admins.size();
}

export circuit getNonce(): Uint<64> {
  return _nonce.read();
}

export circuit getApprovalCount(actionHash: Bytes<32>): Uint<64> {
  if (_approvals.member(disclose(actionHash))) {
    return _approvals.lookup(disclose(actionHash)).size();
  }
  return 0 as Uint<64>;
}

export circuit isApproved(actionHash: Bytes<32>): Boolean {
  return getApprovalCount(actionHash) >= (_threshold as Uint<64>);
}

export circuit isMeterRegistered(meterKeyHash: Bytes<32>): Boolean {
  return _meters.member(disclose(meterKeyHash));
}

export circuit getMeterCount(): Uint<64> {
  return _meters.size();
}

// =============================================================================
// actionHash helpers — single source of truth for approve/execute parity
// =============================================================================
//
// Off-chain signers MUST mirror these exactly. execute* circuits call the
// same helpers so approved hash == recomputed hash.

circuit addAdminActionHash(newAdmin: Bytes<32>): Bytes<32> {
  const opSel = persistentHash<Bytes<32>>(pad(32, "registry:v2:addAdmin"));
  const selfBytes = disclose(kernel.self()).bytes;
  const nextNonce = (_nonce.read() + 1 as Uint<64>) as Field as Bytes<32>;
  return persistentHash<Vector<4, Bytes<32>>>([
    opSel,
    selfBytes,
    disclose(newAdmin),
    nextNonce,
  ]);
}

circuit removeAdminActionHash(removedAdmin: Bytes<32>): Bytes<32> {
  const opSel = persistentHash<Bytes<32>>(pad(32, "registry:v2:removeAdmin"));
  const selfBytes = disclose(kernel.self()).bytes;
  const nextNonce = (_nonce.read() + 1 as Uint<64>) as Field as Bytes<32>;
  return persistentHash<Vector<4, Bytes<32>>>([
    opSel,
    selfBytes,
    disclose(removedAdmin),
    nextNonce,
  ]);
}

circuit setThresholdActionHash(newThreshold: Uint<8>): Bytes<32> {
  const opSel = persistentHash<Bytes<32>>(pad(32, "registry:v2:setThreshold"));
  const selfBytes = disclose(kernel.self()).bytes;
  const dThreshold = disclose(newThreshold);
  const newThresholdBytes = (dThreshold as Field) as Bytes<32>;
  const nextNonce = (_nonce.read() + 1 as Uint<64>) as Field as Bytes<32>;
  return persistentHash<Vector<4, Bytes<32>>>([
    opSel,
    selfBytes,
    newThresholdBytes,
    nextNonce,
  ]);
}

circuit addMeterActionHash(meterKeyHash: Bytes<32>): Bytes<32> {
  const opSel = persistentHash<Bytes<32>>(pad(32, "registry:v2:addMeter"));
  const selfBytes = disclose(kernel.self()).bytes;
  const nextNonce = (_nonce.read() + 1 as Uint<64>) as Field as Bytes<32>;
  return persistentHash<Vector<4, Bytes<32>>>([
    opSel,
    selfBytes,
    disclose(meterKeyHash),
    nextNonce,
  ]);
}

circuit removeMeterActionHash(meterKeyHash: Bytes<32>): Bytes<32> {
  const opSel = persistentHash<Bytes<32>>(pad(32, "registry:v2:removeMeter"));
  const selfBytes = disclose(kernel.self()).bytes;
  const nextNonce = (_nonce.read() + 1 as Uint<64>) as Field as Bytes<32>;
  return persistentHash<Vector<4, Bytes<32>>>([
    opSel,
    selfBytes,
    disclose(meterKeyHash),
    nextNonce,
  ]);
}

// =============================================================================
// Self-governance: addAdmin / removeAdmin / setThreshold
// =============================================================================

export circuit executeAddAdmin(newAdmin: Bytes<32>): [] {
  assert(_initialized, "Not initialized");

  const actionHash = addAdminActionHash(disclose(newAdmin));

  assert(isApproved(actionHash), "addAdmin: not enough approvals");

  _admins.insert(disclose(newAdmin));
  _approvals.remove(actionHash);
  _nonce.increment(1);
}

export circuit executeRemoveAdmin(removedAdmin: Bytes<32>): [] {
  assert(_initialized, "Not initialized");

  const actionHash = removeAdminActionHash(disclose(removedAdmin));

  assert(isApproved(actionHash), "removeAdmin: not enough approvals");
  assert(_admins.member(disclose(removedAdmin)), "Not an admin");
  assert(_admins.size() > (_threshold as Uint<64>), "Would drop admin count below threshold");

  _admins.remove(disclose(removedAdmin));
  _approvals.remove(actionHash);
  _nonce.increment(1);
}

export circuit executeSetThreshold(newThreshold: Uint<8>): [] {
  assert(_initialized, "Not initialized");
  assert(newThreshold > 0 as Uint<8>, "Threshold must be > 0");
  assert((newThreshold as Uint<64>) <= _admins.size(), "Threshold > admin count");

  const actionHash = setThresholdActionHash(disclose(newThreshold));

  assert(isApproved(actionHash), "setThreshold: not enough approvals");

  _threshold = disclose(newThreshold);
  _approvals.remove(actionHash);
  _nonce.increment(1);
}

// =============================================================================
// Registry mutations — multi-sig gated
// =============================================================================

export circuit executeAddMeter(meterKeyHash: Bytes<32>): [] {
  assert(_initialized, "Not initialized");
  assert(!_meters.member(disclose(meterKeyHash)), "Meter already registered");

  const actionHash = addMeterActionHash(disclose(meterKeyHash));

  assert(isApproved(actionHash), "addMeter: not enough approvals");

  _meters.insert(disclose(meterKeyHash));
  _approvals.remove(actionHash);
  _nonce.increment(1);
}

export circuit executeRemoveMeter(meterKeyHash: Bytes<32>): [] {
  assert(_initialized, "Not initialized");
  assert(_meters.member(disclose(meterKeyHash)), "Meter not registered");

  const actionHash = removeMeterActionHash(disclose(meterKeyHash));

  assert(isApproved(actionHash), "removeMeter: not enough approvals");

  _meters.remove(disclose(meterKeyHash));
  _approvals.remove(actionHash);
  _nonce.increment(1);
}
